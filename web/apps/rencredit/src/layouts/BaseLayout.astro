---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';
import { SITE } from '../lib/ui/site';

interface Props {
  title: string;
  description: string;
  /** Не добавлять « — Бренд» к title (главная). */
  rawTitle?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** Страница с закреплённой CTA-панелью на мобильном (поднимает маскота). */
  stickyCta?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}
const { title, description, rawTitle, noindex, ogType = 'website', ogImage, stickyCta, jsonLd, publishedTime, modifiedTime } = Astro.props;
const fullTitle = rawTitle ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const robotsNoindex = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#0d2c26" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
    <ClientRouter />
    <script>
      import '../scripts/main';
    </script>
  </head>
  <body data-sticky-cta={stickyCta ? '' : undefined}>
    <a class="skip" href="#main">К содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Mascot />
  </body>
</html>
