---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/cta.css';
import '../styles/decor.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';
import CookieBar from '../components/CookieBar.astro';
import { SITE, ENV } from '../lib/ui/site';

interface Props {
  title: string;
  description: string;
  /** Не добавлять « — Бренд» к title (главная). */
  rawTitle?: boolean;
  noindex?: boolean;
  /** Абсолютный canonical, если он не равен адресу страницы (статьи на legacy-URL /credit/<slug>.html). */
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** Страница с закреплённой CTA-панелью на мобильном (поднимает маскота). */
  stickyCta?: boolean;
  /** Скрыть маскота (его реплики — про займы): страхование, дебетовые карты, вклады, РКО. */
  noMascot?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}
const { title, description, rawTitle, noindex, canonical: canonicalProp, ogType = 'website', ogImage, stickyCta, noMascot, jsonLd, publishedTime, modifiedTime } = Astro.props;
const fullTitle = rawTitle ? title : `${title} — ${SITE.name}`;
const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// PUBLIC_NOINDEX=true (тестовый поддомен) закрывает от индексации весь сайт.
const robotsNoindex = noindex || ENV.noindex;
// Картинка по умолчанию — статичная public/og/default.png (1200x630).
const ogUrl = new URL(ogImage ?? '/og/default.png', Astro.site ?? Astro.url).href;
// На главной — WebSite + Organization (страницы их не передают).
const home = new URL('/', Astro.site ?? Astro.url).href;
const siteLd = Astro.url.pathname === '/' ? [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: home, inLanguage: 'ru-RU', description: SITE.descriptor },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: home, logo: new URL('/icon-512.png', home).href,
    ...(SITE.email && { email: SITE.email }),
    ...(SITE.legal.owner && { legalName: SITE.legal.owner }),
    ...(SITE.legal.inn && { taxID: SITE.legal.inn }),
  },
] : [];
const ld = [...siteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#0d2c26" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {ENV.yandexVerification && <meta name="yandex-verification" content={ENV.yandexVerification} />}
    {ENV.googleVerification && <meta name="google-site-verification" content={ENV.googleVerification} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
    {/*
      Яндекс Метрика — только после согласия (152-ФЗ, ст. 9). Выбор: localStorage 'fk-consent' = yes|no.
      Скрипт ставит html[data-consent] (yes|no|pending) до отрисовки — от него зависит видимость CookieBar.
      Одинаковый inline-скрипт в <head> ClientRouter не перезапускает, а атрибуты <html> при переходе
      заменяет — поэтому data-consent восстанавливаем на astro:after-swap.
      window.fkConsent(true|false) — из CookieBar и со страницы политики (отзыв согласия).
    */}
    {ENV.metrikaId && (
      <script is:inline define:vars={{ id: Number(ENV.metrikaId) }}>
        var KEY = 'fk-consent';
        var choice = null;
        try { choice = localStorage.getItem(KEY); } catch (e) { /* приватный режим: спросим снова */ }
        var root = document.documentElement;
        var mark = function () { root.dataset.consent = choice === 'yes' || choice === 'no' ? choice : 'pending'; };
        mark();
        document.addEventListener('astro:after-swap', mark);
        var loaded = false;
        var load = function () {
          if (loaded) return;
          loaded = true;
          // Вебвизор выключен. Первый хит шлёт init, дальше — вручную на каждый переход ClientRouter.
          window.ym = window.ym || function () { (window.ym.a = window.ym.a || []).push(arguments); };
          window.ym.l = 1 * new Date();
          window.ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
          var last = location.href;
          document.addEventListener('astro:page-load', function () {
            if (location.href === last) return;
            last = location.href;
            window.ym(id, 'hit', last);
          });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://mc.yandex.ru/metrika/tag.js';
          document.head.appendChild(s);
        };
        window.fkConsent = function (yes) {
          var was = choice;
          choice = yes ? 'yes' : 'no';
          try { localStorage.setItem(KEY, choice); } catch (e) { /* выбор действует до закрытия вкладки */ }
          mark();
          if (yes) return load();
          if (was !== 'yes') return;
          // Отзыв согласия: стираем cookie Метрики (_ym*) и перезагружаем, чтобы выгрузить счётчик.
          document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (name.indexOf('_ym') !== 0) return;
            ['', '; domain=' + location.hostname, '; domain=.' + location.hostname.replace(/^www\./, '')].forEach(function (d) {
              document.cookie = name + '=; Max-Age=0; path=/' + d;
            });
          });
          location.reload();
        };
        if (choice === 'yes') load();
      </script>
    )}
    <ClientRouter />
    <script>
      import '../scripts/main';
    </script>
  </head>
  <body data-sticky-cta={stickyCta ? '' : undefined} data-no-mascot={noMascot ? '' : undefined}>
    <a class="skip" href="#main">К содержимому</a>
    {ENV.metrikaId && <CookieBar />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Mascot />
  </body>
</html>
