---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHero from '../components/decor/SectionHero.astro';
import { SITE } from '../lib/ui/site';

const L = SITE.legal;
const legalRows = [
  ['Владелец сайта', L.owner],
  ['ИНН', L.inn],
  ['ОГРН/ОГРНИП', L.ogrn],
  ['Адрес', L.address],
].filter(([, v]) => v);
---
<BaseLayout title="О проекте и контакты" description={`${SITE.name} — информационный сервис по подбору займов, карт и кредитов. Как мы работаем, как зарабатываем и как с нами связаться.`}>
  <SectionHero title="О проекте" lead="Сравниваем условия, объясняем простым языком, не выдаём займы и не берём деньги с посетителей." pose="wave" outline="compass">
    <Breadcrumbs slot="crumbs" items={[{ label: 'О проекте' }]} />
  </SectionHero>
  <div class="wrap pb-16">
    <div class="prose">
      <p>{SITE.name} — информационный сервис, который помогает сравнить условия микрофинансовых организаций, банков и карт и выбрать подходящее предложение.</p>
      <h2>Кто мы</h2>
      <p>{SITE.disclaimer}</p>
      <p>{SITE.notBank}</p>
      <h2>Как мы зарабатываем</h2>
      <p>Сервис бесплатен для пользователей. Мы получаем вознаграждение от организаций, когда посетитель оформляет заявку по нашей ссылке. Это не влияет на ставку по вашему договору. Порядок предложений на витрине определяется условиями, рейтингом и партнёрскими соглашениями — мы отмечаем это на странице.</p>
      <h2>Как мы собираем условия</h2>
      <p>Данные берутся с официальных сайтов организаций и из публичных источников. Организации могут менять условия без уведомления, поэтому перед подписанием договора проверяйте их на сайте кредитора.</p>
      {SITE.email && <h2>Контакты</h2>}
      {SITE.email && <p>По вопросам сотрудничества и исправления данных: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>}
      {legalRows.length > 0 && (
        <>
          <h2>Реквизиты</h2>
          <ul>{legalRows.map(([k, v]) => <li><b>{k}:</b> {v}</li>)}</ul>
        </>
      )}
      <p>{SITE.risk}</p>
    </div>
  </div>
</BaseLayout>
