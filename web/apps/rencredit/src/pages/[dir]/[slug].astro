---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfferLogo from '../../components/OfferLogo.astro';
import AdMark from '../../components/AdMark.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaTop3 from '../../components/cta/CtaTop3.astro';
import CtaZero from '../../components/cta/CtaZero.astro';
import { KIND_URL, rotate } from '../../lib/cta';
import { getOfferGuides } from '../../lib/content';
import Icon from '../../components/Icon.astro';
import { getOffers, offerHref, pskRange, creditRate, showsRate, isTopEligible, NO_RATE, CTA_LABEL, REVIEW_DIR, PSK_LABEL } from '../../lib/offers';
import { FEATURE_LABELS } from '../../lib/ui/features';
import { range, num, pct, daysWord, moneyRange, termText } from '../../lib/format';
import { SITE } from '../../lib/ui/site';

// Обзоры: /mfo/<slug>/, /karty/<slug>/, /kredity/<slug>/ — раздел по kind (REVIEW_DIR).
export async function getStaticPaths() {
  const offers = await getOffers();
  return offers.map((offer) => ({ params: { dir: REVIEW_DIR[offer.kind], slug: offer.slug }, props: { offer, all: offers } }));
}
const { offer: o, all } = Astro.props;
// «Похожие»: соседи по кольцу среди verified + ПСК того же kind (SEO-10 п. 4, SEO-18) — входящие поровну.
const similar = rotate(all.filter((x) => x.kind === o.kind && isTopEligible(x)), o, o.slug);
const guides = await getOfferGuides(o.slug);
// Кредит — годовая ставка; карта — ставки вне льготного периода в данных нет, показываем только ПСК.
// Без диапазона ПСК ставку не показываем (ч. 3 ст. 28 38-ФЗ) — вместо неё NO_RATE.
const rate = !showsRate(o) ? null : o.kind === 'mfo' ? `${pct(o.rateDayPct)}% в день` : o.kind === 'credit' ? `${creditRate(o)}% годовых` : null;
// ч. 3 ст. 28 38-ФЗ: ПСК показываем раньше ставки и не мельче неё.
const psk = pskRange(o) ?? (o.pskMax ? `до ${pct(o.pskMax)}% годовых` : null);
const tags = o.features.filter((f) => showsRate(o) || f !== 'zero_percent'); // «Без процентов» — тоже ставка
const term = termText(o.kind, o.termMinDays, o.termMaxDays);
const amountLabel = o.kind === 'card' ? 'Кредитный лимит' : 'Сумма';
const termLabel = o.kind === 'card' ? 'Льготный период' : 'Срок';
const kindWord = { mfo: 'Займ', card: 'Карта', credit: 'Кредит' }[o.kind];
const crumb = { mfo: ['Займы', '/zaimy/'], card: ['Карты', '/karty/'], credit: ['Кредиты', '/kredity/'] }[o.kind];
const title = `${o.name}: условия, ставка, как получить — ${kindWord.toLowerCase()} онлайн`;
const desc = o.summary ?? `${o.name}: ${amountLabel.toLowerCase()} ${moneyRange(o.amountMin, o.amountMax)}, ${termLabel.toLowerCase()} ${term}${rate ? `, ставка ${rate}` : ''}. Условия, требования к заёмщику и как получить.`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FinancialProduct',
  name: o.name,
  description: desc,
  // aggregateRating не выводим: rating — редакционная оценка, не отзывы (см. core/schema.ts financialProduct).
};
const rows: [string, string][] = [
  [amountLabel, `${range(o.amountMin, o.amountMax)} ₽`],
  [termLabel, term],
  ...(psk ? ([[PSK_LABEL, psk]] as [string, string][]) : []),
  ...(!rate && o.kind !== 'card' ? ([['Ставка', NO_RATE]] as [string, string][]) : []),
  ...(rate ? ([['Ставка', rate + (o.kind === 'mfo' && o.freeDays && o.features.includes('zero_percent') ? ` (0% первые ${daysWord(o.freeDays)} для новых клиентов)` : '')]] as [string, string][]) : []),
  ...(o.approvalPct ? ([['Заявленное одобрение', `${o.approvalPct}%`]] as [string, string][]) : []),
  ...(o.decisionMinutes ? ([['Время решения', `до ${o.decisionMinutes} мин`]] as [string, string][]) : []),
  ['Возраст заёмщика', `${o.ageMin}–${o.ageMax} лет`],
  ['Гражданство', 'Российская Федерация'],
];
const legal: [string, string][] = [
  ...(o.legalName ? ([['Организация', o.legalName]] as [string, string][]) : []),
  ...(o.cbrLicense ? ([['Номер в реестре ЦБ РФ', o.cbrLicense]] as [string, string][]) : []),
];
---
<BaseLayout title={title} description={desc.slice(0, 200)} stickyCta jsonLd={ld}>
  <div class="wrap page-head"><Breadcrumbs items={[{ label: crumb[0], href: crumb[1] }, { label: o.name }]} /></div>

  <div class="wrap pb-14">
    <div class="rev-hero">
      <OfferLogo offer={o} size="lg" morph />
      <div>
        <p class="eyebrow">Обзор</p>
        <h1 class="mt-1">{o.name}: условия и&nbsp;как получить</h1>
        {o.summary && <p class="lead mt-3">{o.summary}</p>}
        {o.rating ? <p class="rating mt-3"><Icon name="star" />{String(o.rating).replace('.', ',')} из 5{o.reviewsCount ? ` · ${num(o.reviewsCount)} отзывов` : ''}</p> : null}
      </div>
      <div class="grid gap-3">
        <a class="btn btn-cta btn-lg btn-block" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank">{CTA_LABEL[o.kind]}<Icon name="arrow" class="arrow" /></a>
        <p class="text-center text-sm text-mute">Заявка оформляется на сайте организации</p>
        <AdMark offer={o} />
      </div>
    </div>

    <dl class="facts" data-reveal>
      <div class="metric"><dt>{amountLabel}</dt><dd>{moneyRange(o.amountMin, o.amountMax)}</dd></div>
      <div class="metric"><dt>{termLabel}</dt><dd>{term}</dd></div>
      {psk && <div class="metric"><dt>{PSK_LABEL}</dt><dd>{psk}</dd></div>}
      {rate && <div class="metric"><dt>Ставка</dt><dd>{rate}</dd></div>}
      {o.approvalPct ? <div class="metric"><dt>Одобрение</dt><dd>{o.approvalPct}%</dd></div> : null}
    </dl>

    <CtaZero offer={o} />

    {tags.length > 0 && <ul class="oc-tags mt-5 p-0" data-reveal>{tags.map((f) => <li class="tag">{FEATURE_LABELS[f]}</li>)}</ul>}
    {guides.length > 0 && <nav class="mt-5" aria-label="Входит в подборки" data-reveal><b class="text-sm">Входит в подборки</b><div class="chips">{guides.map((g) => <a class="chip no-underline" href={`/${g.id}/`}>{g.data.title.split(':')[0]}</a>)}</div></nav>}

    <h2 class="h2 mt-12" data-reveal>Условия {o.name}</h2>
    <dl class="dl" data-reveal>{rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>

    {(o.pros.length > 0 || o.cons.length > 0) && (
      <div class="pc" data-reveal>
        {o.pros.length > 0 && <div class="pro"><h3>Плюсы</h3><ul>{o.pros.map((p) => <li>{p}</li>)}</ul></div>}
        {o.cons.length > 0 && <div class="con"><h3>Минусы</h3><ul>{o.cons.map((p) => <li>{p}</li>)}</ul></div>}
      </div>
    )}

    {legal.length > 0 && (
      <>
        <h2 class="h2 mt-12" data-reveal>Юридические данные</h2>
        <dl class="dl" data-reveal>{legal.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </>
    )}

    <div class="note-card mt-10" data-reveal>
      {o.verified ? 'Условия сверены с сайтом организации.' : 'Условия приведены по данным организации и могут отличаться.'} Окончательные ставка, сумма и срок определяются кредитором при рассмотрении заявки. {SITE.name} не выдаёт займы.
    </div>

    {similar.length > 0 && (
      <div class="mt-14"><CtaTop3 offers={similar} slot="similar" title="Похожие предложения" moreHref={KIND_URL[o.kind]} moreLabel="Смотреть все" /></div>
    )}
  </div>

  <div class="sticky-cta" role="region" aria-label="Оформить заявку">
    <div class="t">{o.name}<small>Реклама · {o.legalName ?? o.name}</small></div>
    <a class="btn btn-cta" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank">{CTA_LABEL[o.kind]}</a>
  </div>
</BaseLayout>
