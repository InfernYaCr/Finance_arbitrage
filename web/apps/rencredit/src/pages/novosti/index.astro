---
import SectionHero from '../../components/decor/SectionHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getNews } from '../../lib/content';
import { dateRu } from '../../lib/format';

const news = await getNews();
---
<BaseLayout title="Новости финансов, займов и кредитов" description="Свежие новости рынка микрозаймов и кредитования: изменения в законах, ставках и правилах для заёмщиков.">
  <SectionHero title="Новости рынка займов и&nbsp;кредитов" pose="point" outline="calendar">
    <Breadcrumbs slot="crumbs" items={[{ label: 'Новости' }]} />
  </SectionHero>
  <section class="wrap pb-16">
    {news.length > 0 ? (
      <ul class="news-list">
        {news.map((n) => (
          <li data-reveal>
            <a href={`/novosti/${n.id}/`}>
              <time datetime={n.data.publishDate.toISOString()}>{dateRu(n.data.publishDate)}</time>
              <span><strong>{n.data.title}</strong><span class="mt-1 block text-ink-soft">{n.data.description}</span></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty"><h3>Новостей пока нет</h3><p class="lead mx-auto mt-2">Загляните позже.</p></div>
    )}
  </section>
</BaseLayout>
