---
import BaseLayout from '../layouts/BaseLayout.astro';
import Character from '../components/mascots/Character.astro';
import Outline from '../components/decor/Outline.astro';
import { NAV } from '../lib/ui/site';
---
<BaseLayout title="Страница не найдена" description="Такой страницы нет. Вернитесь на главную и подберите займ." noindex>
  <div class="wrap e404">
    <Outline kind="compass" class="e404-bg" />
    <div class="e404-art" aria-hidden="true">
      <div class="big">4<span>0</span>4</div>
      <Character pose="think" size="lg" class="e404-char" />
    </div>
    <h1 class="mt-4 text-3xl">Страница не найдена</h1>
    <p class="lead mx-auto mt-3">Возможно, ссылка устарела или в адресе опечатка. Вернитесь на главную — калькулятор подберёт займ за минуту.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-cta btn-lg" href="/">На главную</a>
      <a class="btn btn-ghost btn-lg" href="/stati/">Читать статьи</a>
    </div>
    <nav class="e404-links" aria-label="Популярные разделы">
      <p>Или загляните в раздел</p>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </div>
</BaseLayout>
