---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена" description="Такой страницы нет. Вернитесь на главную и подберите займ." noindex>
  <div class="wrap e404">
    <div class="big" aria-hidden="true">4<span>0</span>4</div>
    <h1 class="mt-4 text-3xl">Страница не найдена</h1>
    <p class="lead mx-auto mt-3">Возможно, ссылка устарела. Вернитесь на главную — калькулятор подберёт займ за минуту.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-cta btn-lg" href="/">На главную</a>
      <a class="btn btn-ghost btn-lg" href="/stati/">Читать статьи</a>
    </div>
  </div>
</BaseLayout>
