---
// Редирект на партнёрский оффер. Самодостаточный HTML без layout приложения.
// В пуле есть записи status=wait: они приходят с enabled=false и без href (isLinkable → false),
// поэтому страницы для них не генерируются. Если wait-оффер включат и дадут ссылку — путь появится сам.
import { getCollection } from 'astro:content';
import { pool, isLinkable, outboundUrl } from '@pbn/core';

export async function getStaticPaths() {
  // erid (ч. 17 ст. 18.1 38-ФЗ) хранится в контенте (offers и services), а не в пуле.
  const entries = [...(await getCollection('offers')), ...(await getCollection('services'))];
  const erids = new Map(entries.map((e) => [e.data.poolId, e.data.erid]));
  return pool
    .filter((o) => isLinkable(o))
    .map((o) => ({ params: { offer: o.id }, props: { pending: o.status !== 'approve', erid: erids.get(o.id) } }));
}

const { offer } = Astro.params;
const { erid } = Astro.props;
const destination =
  outboundUrl(offer!, {
    source: Astro.site?.hostname ?? 'rencredit-online.ru',
    medium: 'compare',
    campaign: 'go',
    erid,
  }) ?? '/';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <noscript><meta http-equiv="refresh" content={`0;url=${destination}`} /></noscript>
    <title>Переход к партнёру…</title>
    <style>
      body { font: 16px/1.5 system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; color: #1c1c1c; background: #fff; }
      p { max-width: 28rem; padding: 1rem; text-align: center; }
    </style>
  </head>
  <body>
    <p>
      Переходим на сайт партнёра…
      <a href={destination} rel="nofollow sponsored noopener">Нажмите здесь</a>, если переход не произошёл.
    </p>
    {/*
      Метка места клика (scripts/goals.ts): ?p=<слот>&s=<sid> → utm_content/utm_term, раздел из referrer → utm_campaign.
      erid и путь коннектора не трогаем, utm только дописываем. Без s (открыли из контекстного меню) — свой sid.
    */}
    <script define:vars={{ destination }}>
      var q = new URLSearchParams(location.search), u = new URL(destination, location.href);
      var p = q.get('p') || '', s = q.get('s') || '', sec = 'direct';
      try {
        var r = new URL(document.referrer);
        sec = r.origin === location.origin ? r.pathname.split('/')[1] || 'home' : 'ext';
      } catch (e) { /* пустой referrer */ }
      if (!/^[0-9a-f]{12}$/.test(s)) s = Array.from(crypto.getRandomValues(new Uint8Array(6)), function (b) { return b.toString(16).padStart(2, '0'); }).join('');
      u.searchParams.set('utm_content', /^[a-z0-9-]{1,32}$/.test(p) ? p : 'none');
      u.searchParams.set('utm_term', s);
      if (/^[a-z0-9-]{1,48}$/.test(sec)) u.searchParams.set('utm_campaign', sec);
      location.replace(u.href);
    </script>
  </body>
</html>
