---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Showcase from '../components/Showcase.astro';
import Steps from '../components/Steps.astro';
import CompareTable from '../components/CompareTable.astro';
import PostCard from '../components/PostCard.astro';
import Faq from '../components/Faq.astro';
import SeoText from '../components/SeoText.astro';
import { getOffers } from '../lib/offers';
import { getArticles, getNews, articleHref } from '../lib/content';
import { readingMinutes, dateRu } from '../lib/format';
import { SITE } from '../lib/ui/site';
import { HOME_FAQ } from '../lib/ui/faq';

const offers = await getOffers('mfo');
const [articles, news] = await Promise.all([getArticles(), getNews()]);
const topArticles = articles.slice(0, 3);
const topNews = news.slice(0, 4);
const moreServices = [
  { href: '/strahovanie/', t: 'Страхование', d: 'ОСАГО, КАСКО, ипотека, путешествия' },
  { href: '/debetovye-karty/', t: 'Дебетовые карты', d: 'Обслуживание, кешбэк, % на остаток' },
  { href: '/vklady/', t: 'Вклады', d: 'Ставки и условия банков' },
  { href: '/rko/', t: 'РКО для бизнеса', d: 'Расчётный счёт для ИП и ООО' },
];
const compare = [...offers].sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0));
---
<BaseLayout
  rawTitle
  title={`Займы онлайн на карту — сравнение условий МФО | ${SITE.name}`}
  description="Подберите займ онлайн: сравните ставки, суммы и сроки МФО, отфильтруйте «без процентов», «без отказа» и «с плохой КИ» и оформите заявку за несколько минут."
>
  <HomeHero offers={offers} />

  <Showcase offers={offers} title="Все займы: фильтры и сортировка" eyebrow="Витрина предложений" lead="Здесь все предложения сразу. Отметьте «без процентов», «на карту» или «с плохой КИ», задайте возраст и сортировку." />

  <Steps />
  <CompareTable offers={compare} />

  <section class="section pt-0 md:pt-0" aria-labelledby="more-services">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Не только займы</p>
      <h2 class="h2 mt-2" id="more-services" data-reveal>Ещё сервисы</h2>
      <ul class="svc-tiles mt-6" data-reveal>
        {moreServices.map((x) => <li><a href={x.href}><b>{x.t}</b><span>{x.d}</span></a></li>)}
      </ul>
    </div>
  </section>

  {(topArticles.length > 0 || topNews.length > 0) && (
    <section class="section pt-0 md:pt-0">
      <div class="wrap grid gap-10 lg:grid-cols-[2fr_1fr] lg:gap-14">
        {topArticles.length > 0 && (
          <div>
            <div class="flex items-end justify-between gap-4" data-reveal>
              <div><p class="eyebrow">Блог</p><h2 class="h2 mt-2">Полезные статьи</h2></div>
              <a class="link-btn" href="/stati/">Все статьи</a>
            </div>
            <div class="grid-cards" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr))">
              {topArticles.map((a, i) => (
                <PostCard index={i} href={articleHref(a)} title={a.data.title} description={a.data.description} date={a.data.publishDate} category={a.data.category} cover={a.data.cover} minutes={readingMinutes(a.body ?? '')} />
              ))}
            </div>
          </div>
        )}
        {topNews.length > 0 && (
          <div>
            <div class="flex items-end justify-between gap-4" data-reveal>
              <div><p class="eyebrow">Новости</p><h2 class="h2 mt-2">Что нового</h2></div>
              <a class="link-btn" href="/novosti/">Все</a>
            </div>
            <ul class="news-list" data-reveal>
              {topNews.map((n) => (
                <li><a href={`/novosti/${n.id}/`} style="grid-template-columns: 1fr"><time datetime={n.data.publishDate.toISOString()}>{dateRu(n.data.publishDate)}</time><strong>{n.data.title}</strong></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <Faq items={HOME_FAQ} title="Вопросы о займах и сервисе" />

  <SeoText>
    <h2>Как выбрать займ онлайн</h2>
    <p>Займ онлайн — это быстрый способ получить небольшую сумму на срок от нескольких дней до года без визита в офис. Решение принимает автоматическая система скоринга, деньги чаще всего поступают на банковскую карту. На {SITE.name} собраны актуальные условия организаций, чтобы вы сравнили их в одном месте и не открывали десятки сайтов.</p>
    <h3>На что смотреть в первую очередь</h3>
    <ul>
      <li><strong>Ставка в день и срок.</strong> Именно они определяют переплату. Для краткосрочного займа сумма процентов не может превышать 100% от суммы займа.</li>
      <li><strong>Льготный период.</strong> Если вы берёте займ впервые, ищите предложения «0% на первый займ» — при своевременном возврате переплаты не будет.</li>
      <li><strong>Одобрение и скорость.</strong> Заявленный процент одобрения — ориентир, не гарантия. Чем выше доход и лучше кредитная история, тем выше шанс.</li>
      <li><strong>Требования к заёмщику.</strong> Возраст, документы, наличие фото паспорта или селфи.</li>
    </ul>
    <h3>Займ с плохой кредитной историей</h3>
    <p>Часть МФО принимает заявки от клиентов с просрочками и низким скорингом. Одобрение не гарантировано, ставка может быть выше. Не берите несколько займов одновременно: это увеличивает долговую нагрузку и ухудшает историю ещё сильнее.</p>
    <h3>Ответственное заимствование</h3>
    <p>Берите займ только на срок и сумму, которые сможете вернуть. Перед подписанием договора внимательно прочитайте полную стоимость займа, условия продления и штрафы. Если возникли сложности с возвратом, сразу свяжитесь с кредитором — многие организации предлагают реструктуризацию.</p>
    <p>{SITE.name} не является МФО или банком и не выдаёт займы; информация на сайте носит справочный характер.</p>
  </SeoText>
</BaseLayout>
