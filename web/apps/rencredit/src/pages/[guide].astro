---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Showcase from '../components/Showcase.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaUsp from '../components/cta/CtaUsp.astro';
import CtaCallout from '../components/cta/CtaCallout.astro';
import CtaNext from '../components/cta/CtaNext.astro';
import CtaSticky from '../components/cta/CtaSticky.astro';
import { getGuides, getIndexableGuides, getGuideOffers } from '../lib/content';
import { RESERVED_SLUGS, ORG } from '../lib/ui/site';
import { reviewHref } from '../lib/offers';
import { itemListProducts } from '@pbn/core';
import { FEATURE_LABELS } from '../lib/ui/features';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides
    .filter((g) => !RESERVED_SLUGS.includes(g.id))
    .map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const { offers, preset, thin } = await getGuideOffers(guide);
const ld = itemListProducts(guide.data.title, offers, ORG.url, reviewHref);
// Тонкая подборка: честно говорим, что подтверждённых предложений мало, и показываем все займы.
const lead = thin && guide.data.feature
  ? `Предложений с подтверждённым условием «${FEATURE_LABELS[guide.data.feature]}» пока меньше трёх, поэтому отдельную подборку мы не собираем. Ниже — все займы из нашего каталога.`
  : guide.data.description;
const others = (await getIndexableGuides()).filter((g) => g.id !== guide.id && !RESERVED_SLUGS.includes(g.id));
const calloutCat = guide.data.feature === 'zero_percent' ? 'zaimy-zero' : guide.data.feature === 'bad_history' || guide.data.feature === 'with_overdue' ? 'kreditnaya-istoriya' : guide.data.kind === 'card' ? 'karty' : guide.data.kind === 'credit' ? 'kredity' : 'zaimy';
---
<BaseLayout title={guide.data.title} description={guide.data.description} noindex={thin} jsonLd={ld}>
  <div class="wrap page-head"><Breadcrumbs items={[{ label: 'Займы', href: '/zaimy/' }, { label: guide.data.navLabel }]} /></div>
  <div class="wrap"><CtaUsp slim slot="guide-usp" /></div>
  <Showcase offers={offers} preset={preset} h="h1" title={guide.data.title} eyebrow="Подборка" lead={lead} />
  <section class="section pt-0 md:pt-0">
    <div class="wrap">
      <CtaCallout category={calloutCat} offerKind={guide.data.kind} slot="guide-callout" />
      <div class="prose"><Content /></div>
      <CtaNext kind={guide.data.kind} slot="guide-next" />
    </div>
  </section>
  <Faq items={guide.data.faq} />
  {others.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <div class="wrap">
        <h2 class="h2" data-reveal>Другие подборки</h2>
        <div class="chips">{others.map((g) => <a class="chip no-underline" href={`/${g.id}/`}>{g.data.navLabel}</a>)}</div>
      </div>
    </section>
  )}
  <CtaSticky category={calloutCat} offerKind={guide.data.kind} />
</BaseLayout>
