---
import ArticleView from '../../components/ArticleView.astro';
import { getArticles, legacySlug } from '../../lib/content';

// Статьи с legacyUrl живут только на /credit/<slug>.html (см. pages/credit/[slug].astro) — дублей нет.
export async function getStaticPaths() {
  const articles = await getArticles();
  return articles
    .filter((entry) => !legacySlug(entry))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry, articles } }));
}
const { entry, articles } = Astro.props;
---
<ArticleView entry={entry} articles={articles} />
