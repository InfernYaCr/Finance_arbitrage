---
/** «Талон» предложения в живой подборке главной. Числа пересчитывает home-picker.ts. */
import OfferLogo from '../OfferLogo.astro';
import Icon from '../Icon.astro';
import { type Offer, offerHref, reviewHref } from '../../lib/offers';
import { num, rub, daysWord } from '../../lib/format';
import { type Quote, overText } from '../../scripts/home-logic';

interface Props { offer: Offer; index: number; quote: Quote; shown: boolean }
const { offer: o, index, quote: q, shown } = Astro.props;
const free = o.features.includes('zero_percent') ? o.freeDays ?? 0 : 0;
const limits = `до ${num(o.amountMax)} ₽, ${o.termMinDays}–${o.termMaxDays} дн.`;
---
<li class="hp-ticket" data-hp-offer hidden={!shown || undefined}
  data-sum-min={o.amountMin} data-sum-max={o.amountMax} data-term-min={o.termMinDays} data-term-max={o.termMaxDays}
  data-rate={o.rateDayPct} data-free={free} data-prio={o.priority ?? 0} data-idx={index} data-features={o.features.join(',')}>
  <div class="hp-t-head">
    <OfferLogo offer={o} />
    <div class="min-w-0">
      <a class="hp-t-name" href={reviewHref(o)}>{o.name}</a>
      <p class="hp-t-limits">{limits}</p>
    </div>
    {free > 0 && <span class="hp-t-badge">0% {daysWord(free)}<span class="sr-only"> для первого займа</span></span>}
  </div>
  <div class="hp-t-sum">
    <span class="hp-t-k">К возврату</span>
    <b class="hp-t-back" data-t-back>{rub(q.back)}</b>
    <span class="hp-t-over" data-t-over>{overText(q, rub)}</span>
  </div>
  <a class="btn btn-cta hp-t-cta" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank" data-cta={o.slug}>Получить деньги<Icon name="arrow" class="arrow" /></a>
</li>
