---
/** Предложение в живой подборке главной: та же карточка, что в витрине, + расчёт под запрос. Числа пересчитывает home-picker.ts. */
import OfferCard from '../OfferCard.astro';
import { type Offer, showsRate } from '../../lib/offers';
import { rub } from '../../lib/format';
import { type Quote, overText } from '../../scripts/home-logic';

interface Props { offer: Offer; index: number; quote: Quote; shown: boolean }
const { offer: o, index, quote: q, shown } = Astro.props;
const rated = showsRate(o); // без ПСК не показываем ни «0%», ни расчёт по ставке
const free = rated && o.features.includes('zero_percent') ? o.freeDays ?? 0 : 0;
---
<li class="hp-ticket" data-hp-offer hidden={!shown || undefined}
  data-sum-min={o.amountMin} data-sum-max={o.amountMax} data-term-min={o.termMinDays} data-term-max={o.termMaxDays}
  data-rate={rated ? o.rateDayPct : undefined} data-free={free} data-prio={o.priority ?? 0} data-idx={index} data-features={o.features.join(',')}>
  <OfferCard offer={o} index={index} morph={false} ad>
    {rated && (
      <p slot="quote" class="oc-quote">
        <span class="oc-quote-k">К возврату</span>
        <b data-t-back>{rub(q.back)}</b>
        <span class="oc-quote-over" data-t-over>{overText(q, rub)}</span>
      </p>
    )}
  </OfferCard>
</li>
