---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
import Faq from '../components/Faq.astro';
import Fact from '../components/Fact.astro';
import CtaH2 from './cta/CtaH2.astro';
import CtaTop3 from './cta/CtaTop3.astro';
import CtaNext from './cta/CtaNext.astro';
import CtaAside from './cta/CtaAside.astro';
import CtaSticky from './cta/CtaSticky.astro';
import { getCtaData, topOffers, resolveKind, kindForArticle, rotate, KIND_URL } from '../lib/cta';
import { articleHref, articleCanonical, getIndexableGuides } from '../lib/content';
import { isRefi } from '../lib/offers';
import { readingMinutes, dateRu } from '../lib/format';
import { CATEGORY_LABELS, CATEGORY_HUB, KIND_HUB, EDITORIAL, ORG } from '../lib/ui/site';
import { article, canonicalUrl } from '@pbn/core';

interface Props { entry: CollectionEntry<'articles'>; articles: CollectionEntry<'articles'>[] }
const { entry, articles } = Astro.props;
const canonical = articleCanonical(entry);
const { Content, headings } = await render(entry);
(Astro.locals as Record<string, unknown>).cta = { h2: 0, category: entry.data.category, offerKind: entry.data.offerKind, slug: entry.id };
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const ctaData = await getCtaData();
const wantedKind = kindForArticle(d.category, d.offerKind);
const hasKind = ctaData.all.some((o) => o.kind === wantedKind);
const offers = hasKind ? topOffers(ctaData, wantedKind, entry.id, 3, d.category === 'refinansirovanie' ? isRefi : undefined) : [];
const kindUrl = KIND_URL[resolveKind(wantedKind, ctaData)];
// «Читайте также»: соседи по кольцу внутри рубрики (articles — по дате), в маленькой рубрике — добор соседями по всем статьям.
const self = articles.find((a) => a.id === entry.id);
const near = rotate(articles.filter((a) => a.data.category === d.category), self, entry.id);
const related = [...near, ...rotate(articles.filter((a) => !near.includes(a)), self, entry.id, 3 - near.length)];
// Крошки по логическому родителю: Главная › хаб › кластер › статья (≤4 уровней).
const hub = CATEGORY_HUB[d.category] ?? KIND_HUB[wantedKind];
const cluster = hub.cluster ? (await getIndexableGuides()).find((g) => g.id === hub.cluster) : undefined;
const crumbs = [{ label: hub.label, href: hub.href }, ...(cluster ? [{ label: cluster.data.navLabel, href: `/${cluster.id}/` }] : []), { label: d.title }];
const ld = article({
  url: canonical ?? canonicalUrl(ORG.url, Astro.url.pathname), headline: d.title, description: d.description, datePublished: d.publishDate, dateModified: d.updatedDate,
  author: EDITORIAL, image: d.cover, publisher: ORG,
});
---
<BaseLayout canonical={canonical} title={d.title} description={d.description} ogType="article" ogImage={d.cover} jsonLd={ld} publishedTime={d.publishDate} modifiedTime={d.updatedDate}>
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <h1 class="max-w-4xl">{d.title}</h1>
    <div class="meta-line">
      <span class="pill">{CATEGORY_LABELS[d.category]}</span>
      <time datetime={d.publishDate.toISOString()}>{dateRu(d.publishDate)}</time>
      {d.updatedDate && <span>Обновлено {dateRu(d.updatedDate)}</span>}
      <span>{readingMinutes(entry.body ?? '')} мин чтения</span>
      <span>{d.author}</span>
    </div>
  </div>

  <div class="wrap article-grid">
    <article>
      <div class="prose"><Content components={{ h2: CtaH2, Fact }} /></div>

      <CtaTop3 offers={offers} slot="top3" title="Подходящие предложения по теме" moreHref={kindUrl} moreLabel="Все предложения" />
      <CtaNext kind={wantedKind} exclude={entry.id} />
    </article>
    <aside class="hidden lg:block">
      <div class="side-stack">
        {toc.length > 0 && <nav class="toc" aria-label="Содержание"><b>Содержание</b>
          <ol>{toc.map((h) => <li><a class:list={[h.depth === 3 && 'sub2']} href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>}
        <CtaAside category={d.category} offerKind={d.offerKind} />
      </div>
    </aside>
  </div>

  <Faq items={d.faq} />

  {related.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <div class="wrap">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2" data-reveal><h2 class="h2">Читайте также</h2><a class="font-bold" href="/stati/">Все статьи</a></div>
        <div class="grid-cards">
          {related.map((a, i) => <PostCard index={i} href={articleHref(a)} title={a.data.title} description={a.data.description} date={a.data.publishDate} category={a.data.category} cover={a.data.cover} minutes={readingMinutes(a.body ?? '')} />)}
        </div>
      </div>
    </section>
  )}
  <CtaSticky category={d.category} offerKind={d.offerKind} />
</BaseLayout>
