---
/**
 * Персонаж сайта — карта «Компас». КОНТРАКТ (не менять сигнатуру):
 *   <Character pose="wave|point|think|cheer|shield|coins" size="sm|md|lg" class? />
 * Декоративный: aria-hidden. Реализацию рисует агент «маскоты и визуал».
 */
interface Props {
  pose?: 'wave' | 'point' | 'think' | 'cheer' | 'shield' | 'coins';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { pose = 'wave', size = 'md', class: cls = '' } = Astro.props;
const px = { sm: 72, md: 120, lg: 180 }[size];
---
<svg class={`character character--${pose} ${cls}`} width={px} height={px * 0.8} viewBox="0 0 104 80" aria-hidden="true" data-pose={pose}>
  <g transform="rotate(-6 52 42)">
    <rect x="6" y="8" width="92" height="62" rx="12" fill="#13876f" />
    <rect x="14" y="14" width="14" height="10" rx="2.5" fill="#ffb800" />
    <circle cx="38" cy="46" r="6" fill="#fff" /><circle cx="66" cy="46" r="6" fill="#fff" />
    <path d="M42 58q10 8 20 0" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
  </g>
</svg>
