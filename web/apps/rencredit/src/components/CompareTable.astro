---
import OfferLogo from './OfferLogo.astro';
import AdMark from './AdMark.astro';
import Icon from './Icon.astro';
import { type Offer, offerHref, reviewHref, pskRange, showsRate, NO_RATE, PSK_LABEL } from '../lib/offers';
import { range } from '../lib/format';
interface Props { offers: Offer[]; title?: string }
const { offers, title = 'Сравнение лучших предложений' } = Astro.props;
const top = offers.slice(0, 5);
const zero = (o: Offer) => showsRate(o) && !!o.freeDays && o.features.includes('zero_percent');
// Необязательные колонки — только если значение есть хотя бы у одного оффера.
const hasZero = top.some(zero);
const hasAppr = top.some((o) => o.approvalPct);
const hasDec = top.some((o) => o.decisionMinutes);
const cols = 6 + Number(hasZero) + Number(hasAppr) + Number(hasDec);
---
{top.length > 0 && (
  <section class="section pt-0 md:pt-0">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Сравнение</p>
      <h2 class="h2 mt-2" data-reveal>{title}</h2>
      <div class="tbl-wrap" data-reveal tabindex="0" role="region" aria-label="Сравнительная таблица, прокручивается по горизонтали">
        <table class="cmp">
          <thead><tr><th>Организация</th><th>Сумма</th><th>Срок</th><th class="cmp-psk">{PSK_LABEL}</th><th>Ставка в день</th>{hasZero && <th>Первый займ</th>}{hasAppr && <th>Одобрение</th>}{hasDec && <th>Решение</th>}<th><span class="sr-only-x">Действие</span></th></tr></thead>
          <tbody>
            {top.map((o) => (
              <>
              <tr class="cmp-main">
                <td><a class="who no-underline" href={reviewHref(o)}><OfferLogo offer={o} />{o.name}</a></td>
                <td>{range(o.amountMin, o.amountMax)}&nbsp;₽</td>
                <td>{o.termMinDays}–{o.termMaxDays}&nbsp;дн.</td>
                <td>{pskRange(o) ?? '—'}</td>
                <td>{showsRate(o) ? `${String(o.rateDayPct).replace('.', ',')}%` : NO_RATE}</td>
                {hasZero && <td>{zero(o) ? <b class="text-ok">0% · {o.freeDays}&nbsp;дн.</b> : '—'}</td>}
                {hasAppr && <td>{o.approvalPct ? `${o.approvalPct}%` : '—'}</td>}
                {hasDec && <td>{o.decisionMinutes ? `${o.decisionMinutes} мин` : '—'}</td>}
                <td><a class="btn btn-cta" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank">Получить<Icon name="arrow" class="arrow" /></a></td>
              </tr>
              <tr class="cmp-ad"><td colspan={cols}><AdMark offer={o} /></td></tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}
