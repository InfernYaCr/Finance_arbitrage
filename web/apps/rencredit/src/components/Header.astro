---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { SITE, NAV } from '../lib/ui/site';
import { getGuides } from '../lib/content';

const guides = await getGuides();
const path = Astro.url.pathname;
const isCurrent = (href?: string) => !!href && (href === '/' ? path === '/' : path.startsWith(href));
// Подменю «Займы» — подборки (guides); остальные — из NAV.
const items = NAV.map((n) => n.label === 'Займы' && guides.length > 0
  ? { ...n, sub: [{ label: 'Все займы', href: n.href! }, ...guides.map((g) => ({ label: g.data.navLabel, href: `/${g.id}/` }))] }
  : n);
---
<header class="site-header" data-header>
  <div class="hdr-bg" aria-hidden="true"></div>
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label={`${SITE.name} — на главную`}>
      <LogoMark class="brand-mark" /><span>{SITE.name}</span>
    </a>
    <nav class="nav" aria-label="Основная навигация">
      {items.map((n) => {
        const current = isCurrent(n.href) || !!n.sub?.some((x) => isCurrent(x.href));
        return n.sub ? (
          <div class="has-sub">
            {n.href
              ? <a class="nav-link" href={n.href} aria-current={current ? 'page' : undefined}>{n.label}<Icon name="chevron" class="chev" /></a>
              : <button type="button" class="nav-btn" aria-haspopup="true" data-current={current ? '' : undefined}>{n.label}<Icon name="chevron" class="chev" /></button>}
            <div class="sub">{n.sub.map((x) => <a href={x.href}>{x.label}</a>)}</div>
          </div>
        ) : (
          <a class="nav-link" href={n.href} aria-current={current ? 'page' : undefined}>{n.label}</a>
        );
      })}
    </nav>
    <div class="hdr-actions">
      <button type="button" class="icon-btn" data-search-open aria-label="Поиск по сайту"><Icon name="search" /></button>
      <a class="btn btn-cta hdr-cta" href="/#calc" data-pick>Подобрать займ</a>
      <button type="button" class="icon-btn burger" data-burger aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="icon-open" /><Icon name="close" class="icon-close hidden" />
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label="Мобильное меню">
    {items.map((n) => n.sub ? (
      <details>
        <summary>{n.label} <Icon name="chevron" class="h-5 w-5" /></summary>
        {n.sub.map((x) => <a href={x.href}>{x.label}</a>)}
      </details>
    ) : <a href={n.href}>{n.label}</a>)}
    <a class="btn btn-cta btn-lg btn-block mt-6 justify-center border-0" href="/#calc" data-pick>Подобрать займ</a>
  </nav>
  <dialog class="search-dlg" data-search aria-label="Поиск по сайту">
    <div class="search-box">
      <input type="search" placeholder="Например: займ без отказа" aria-label="Поисковый запрос" autocomplete="off" data-search-input />
      <ul class="search-res" data-search-res></ul>
    </div>
  </dialog>
</header>
