---
---
<aside class="mascot" data-mascot data-state="off" aria-label="Помощник" transition:persist="mascot">
  <div class="mascot-bubble" role="status" aria-live="polite">
    <p data-line>Привет! Подберу займ за минуту</p>
    <div class="mascot-actions">
      <button type="button" class="btn btn-cta" data-act="pick">Подобрать</button>
      <button type="button" class="btn btn-ghost" data-act="close">Закрыть</button>
    </div>
  </div>
  <button type="button" class="mascot-body" data-act="toggle" aria-label="Помощник: подсказки">
    <svg viewBox="0 0 104 80" width="104" height="80" aria-hidden="true">
      <defs>
        <linearGradient id="mg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#19a58a"/><stop offset="1" stop-color="#0b6354"/></linearGradient>
      </defs>
      <g transform="rotate(-6 52 42)">
        <rect x="6" y="8" width="92" height="62" rx="12" fill="url(#mg)" />
        <rect x="6" y="20" width="92" height="9" fill="#08201b" opacity=".35" />
        <rect x="14" y="14" width="14" height="10" rx="2.5" fill="#ffb800" />
        <g class="eye"><ellipse cx="38" cy="46" rx="6" ry="7.5" fill="#fff" /><circle cx="39.5" cy="47" r="3.4" fill="#10231f" /></g>
        <g class="eye"><ellipse cx="66" cy="46" rx="6" ry="7.5" fill="#fff" /><circle cx="67.5" cy="47" r="3.4" fill="#10231f" /></g>
        <path d="M42 58q10 8 20 0" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
        <circle cx="26" cy="56" r="4" fill="#ffb800" opacity=".55" /><circle cx="80" cy="56" r="4" fill="#ffb800" opacity=".55" />
      </g>
    </svg>
  </button>
</aside>
