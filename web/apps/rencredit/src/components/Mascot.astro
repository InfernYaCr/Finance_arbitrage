---
import Character from './mascots/Character.astro';
---
{/*
  Плавающая группа справа внизу: карта-маскот + кнопка «Наверх». Persist — переживает переходы.
  Отступ снизу: CSS-переменная --float-bottom (по умолчанию 16px), см. styles/decor.css.
*/}
<div class="float-group" data-float transition:persist="float">
  <aside class="mascot" data-mascot data-state="off" aria-label="Помощник">
    <div class="mascot-bubble" role="status" aria-live="polite">
      <p data-line>Привет! Подберу займ за минуту</p>
      <div class="mascot-actions">
        <button type="button" class="btn btn-cta" data-act="pick">Подобрать</button>
        <button type="button" class="btn btn-ghost" data-act="close">Закрыть</button>
      </div>
    </div>
    <button type="button" class="mascot-body" data-act="toggle" aria-label="Помощник: подсказки">
      <Character pose="wave" size="sm" class="mascot-char" />
    </button>
  </aside>
  <button type="button" class="to-top" data-to-top aria-label="Наверх" tabindex="-1">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg>
  </button>
</div>
