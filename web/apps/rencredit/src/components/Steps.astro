---
const steps = [
  { t: 'Укажите сумму и срок', d: 'Передвиньте ползунки — мы сразу покажем, у каких организаций эти условия доступны и какая будет переплата.' },
  { t: 'Выберите предложение', d: 'Сравните ставку, одобрение и скорость решения. Отфильтруйте «без процентов», «на карту» или «с плохой КИ».' },
  { t: 'Оформите заявку на сайте МФО', d: 'Нажмите «Получить деньги» и заполните анкету у кредитора. Решение — обычно за несколько минут.' },
];
---
<section class="section" id="how">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Как это работает</p>
    <h2 class="h2 mt-2" data-reveal>Как получить займ за 3 шага</h2>
    <ol class="steps list-none p-0">
      {steps.map((s, i) => <li class="step" data-reveal style={`--i:${i}`}><h3>{s.t}</h3><p>{s.d}</p></li>)}
    </ol>
  </div>
</section>
