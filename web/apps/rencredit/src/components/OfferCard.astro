---
import OfferLogo from './OfferLogo.astro';
import Icon from './Icon.astro';
import { type Offer, offerHref, reviewHref, pskRange, creditRate, showsRate, NO_RATE, CTA_LABEL, PSK_LABEL } from '../lib/offers';
import { num, daysWord, moneyRange, termText } from '../lib/format';
import { FEATURE_LABELS } from '../lib/ui/features';

interface Props { offer: Offer; index?: number; morph?: boolean }
const { offer: o, index = 0, morph = true } = Astro.props;
const rated = showsRate(o);
const zero = rated && o.features.includes('zero_percent') && o.freeDays;
const zeroText = zero ? (o.kind === 'mfo' ? `0% первый займ ${daysWord(o.freeDays!)}` : `Без % ${termText('card', 1, o.freeDays!)}`) : '';
// Карта: ставки вне льготного периода в данных нет — вместо «Ставки» только ПСК (psk-line). ПСК всегда выше ставки (ч. 3 ст. 28 38-ФЗ).
const rateText = !rated ? null : o.kind === 'mfo' ? `${String(o.rateDayPct).replace('.', ',')}% / день` : o.kind === 'credit' ? `${creditRate(o)}% год.` : null;
const shown = o.features.filter((f) => rated || f !== 'zero_percent').slice(0, 4);
const psk = pskRange(o);
---
<article class="offer-card" data-offer data-slug={o.slug} data-kind={o.kind}
  data-sum-min={o.amountMin} data-sum-max={o.amountMax} data-term-min={o.termMinDays} data-term-max={o.termMaxDays}
  data-rate={rated ? o.rateDayPct : undefined} data-free={o.freeDays ?? 0} data-appr={o.approvalPct ?? 0} data-rating={o.rating ?? 0}
  data-age-min={o.ageMin} data-age-max={o.ageMax} data-prio={o.priority ?? 0} data-idx={index} data-features={o.features.join(',')}
  data-reveal style={`--i:${Math.min(index, 6)}`}>
  {psk ? <p class="psk-line"><span>{PSK_LABEL}:</span> {psk}</p> : <p class="psk-line">{NO_RATE}</p>}
  <div class="oc-head">
    <OfferLogo offer={o} morph={morph} />
    <div class="min-w-0">
      <a class="oc-name" href={reviewHref(o)}>{o.name}</a>
      {o.rating ? <div class="rating"><Icon name="star" /><span>{String(o.rating).replace('.', ',')}</span>{o.reviewsCount ? <span class="text-mute font-medium">· {num(o.reviewsCount)} отз.</span> : null}</div> : null}
    </div>
    {zero ? <span class="oc-badge">{zeroText}</span> : o.features.includes('new') ? <span class="oc-badge hot">Новинка</span> : null}
  </div>
  <div class="oc-body">
    <dl class:list={['oc-metrics', { 'oc-metrics-2': !rateText }]}>
      <div class="metric"><dt>{o.kind === 'card' ? 'Лимит' : 'Сумма'}</dt><dd>{moneyRange(o.amountMin, o.amountMax)}</dd></div>
      <div class="metric"><dt>{o.kind === 'card' ? 'Льготный период' : 'Срок'}</dt><dd>{termText(o.kind, o.termMinDays, o.termMaxDays)}</dd></div>
      {rateText && <div class="metric"><dt>Ставка</dt><dd>{rateText}</dd></div>}
    </dl>
    <ul class="oc-facts">
      {o.approvalPct ? <li><Icon name="check" />Одобрение {o.approvalPct}%</li> : null}
      {o.decisionMinutes ? <li><Icon name="clock" />Решение за {o.decisionMinutes}&nbsp;мин</li> : null}
      <li><Icon name="user" />{o.ageMin}–{o.ageMax} лет</li>
    </ul>
    {shown.length ? <ul class="oc-tags">{shown.map((f) => <li class="tag">{FEATURE_LABELS[f]}</li>)}</ul> : null}
  </div>
  <div class="oc-cta">
    <a class="btn btn-cta btn-lg" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank" data-cta={o.slug}>{CTA_LABEL[o.kind]}<Icon name="arrow" class="arrow" /></a>
    <a class="more" href={reviewHref(o)}>Обзор и условия</a>
  </div>
  {!o.verified && <p class="ad-mark">Условия по данным организации, не сверены редакцией.</p>}
</article>
