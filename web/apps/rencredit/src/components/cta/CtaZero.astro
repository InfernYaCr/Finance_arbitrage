---
/** Плашка условий 0% в обзоре МФО. Только если в данных оффера есть льготные дни. */
import Icon from '../Icon.astro';
import AdMark from '../AdMark.astro';
import { offerHref, pskRange, PSK_LABEL, type Offer } from '../../lib/offers';
import { daysWord } from '../../lib/format';

interface Props { offer: Offer }
const { offer: o } = Astro.props;
// Только МФО: у карт «0%» — льготный период, а не первый займ («Дальше — 0% в день» было бы неверно).
const show = o.kind === 'mfo' && o.features.includes('zero_percent') && !!o.freeDays;
const rate = String(o.rateDayPct).replace('.', ',');
const psk = pskRange(o);
---
{show && (
  <aside class="cta cta-zero" aria-label="Условия 0%" data-cta-slot="zero">
    <div class="z-big" aria-hidden="true">0%</div>
    <div class="z-body">
      {psk && <p class="psk-line">{PSK_LABEL}: {psk}</p>}
      <p class="cta-title">Первые {daysWord(o.freeDays!)} без процентов</p>
      <p class="cta-sub">Для новых клиентов. Дальше — {rate}% в день. Условия льготного периода подтверждает МФО при оформлении заявки.</p>
    </div>
    <div class="z-go">
      <a class="btn btn-cta" href={offerHref(o)} rel="sponsored nofollow noopener" target="_blank" data-cta="zero">Оформить на 0%<Icon name="arrow" class="arrow" /></a>
      <AdMark offer={o} class="cta-fine" />
    </div>
  </aside>
)}
