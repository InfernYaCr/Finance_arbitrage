RewriteRule ^mfo/beriberu/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/centrofinans/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/creditplus/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/hurmakredit/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/ilma/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/joymoney/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/krediska/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/manicash/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/skela-money/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/zanimatelnye-finansy/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
RewriteRule ^mfo/zaymigo/?$ https://%{HTTP_HOST}/zaimy/ [R=301,L]
# --- Обзоры карт и кредитов переехали с /mfo/<slug>/ (kind из src/content/offers) ---
RewriteRule ^mfo/akbars-115/?$ https://%{HTTP_HOST}/karty/akbars-115/ [R=301,L]
RewriteRule ^mfo/alfa-kredit-nalichnymi/?$ https://%{HTTP_HOST}/kredity/alfa-kredit-nalichnymi/ [R=301,L]
RewriteRule ^mfo/alfa-refinansirovanie/?$ https://%{HTTP_HOST}/kredity/alfa-refinansirovanie/ [R=301,L]
RewriteRule ^mfo/halva/?$ https://%{HTTP_HOST}/karty/halva/ [R=301,L]
RewriteRule ^mfo/otp-120/?$ https://%{HTTP_HOST}/karty/otp-120/ [R=301,L]
RewriteRule ^mfo/ozon-kreditnaya-karta/?$ https://%{HTTP_HOST}/karty/ozon-kreditnaya-karta/ [R=301,L]
RewriteRule ^mfo/tbank-credit/?$ https://%{HTTP_HOST}/karty/tbank-credit/ [R=301,L]
RewriteRule ^mfo/tbank-drive/?$ https://%{HTTP_HOST}/karty/tbank-drive/ [R=301,L]
RewriteRule ^mfo/tbank-kredit-nalichnymi/?$ https://%{HTTP_HOST}/kredity/tbank-kredit-nalichnymi/ [R=301,L]
RewriteRule ^mfo/tbank-refinansirovanie/?$ https://%{HTTP_HOST}/kredity/tbank-refinansirovanie/ [R=301,L]
RewriteRule ^mfo/uralsib-120/?$ https://%{HTTP_HOST}/karty/uralsib-120/ [R=301,L]

# --- Общие правила WordPress ---
# Архивы авторов
RewriteRule ^author/.*$ https://%{HTTP_HOST}/o-proekte/ [R=301,L]
# Пагинация рубрики блога /credit/page/N
RewriteRule ^credit/page/\d+/?$ https://%{HTTP_HOST}/stati/ [R=301,L]
# Пагинация главной /page/N
RewriteRule ^page/\d+/?$ https://%{HTTP_HOST}/ [R=301,L]
# Старая точка входа WP
RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L]
# Yoast/WP-карты сайта -> индекс карты нового сайта (Astro: sitemap-index.xml)
RewriteRule ^(sitemap_index|sitemap|[a-z0-9_-]+-sitemap[0-9]*|wp-sitemap[a-z0-9_-]*)\.(xml|xsl)$ https://%{HTTP_HOST}/sitemap-index.xml [R=301,L]
# Прочие feed (/…/feed/, /feed/atom/, /comments/feed/ и т.п.), не описанные в map.json -> 410
RewriteRule (^|/)feed(/[a-z0-9-]+)?/?$ - [G,L]
# Служебное WordPress: админка, API, xmlrpc, плагины/темы/ядро -> 410
RewriteRule ^wp-(admin|json|content|includes)(/|$) - [G,L]
RewriteRule ^(wp-[a-z-]+|xmlrpc)\.php$ - [G,L]
</IfModule>
# END LEGACY 301

# --- 5b. Слитые страницы нового сайта (руками; вне генерируемого блока) ---------
# /zaimy-s-prosrochkami/ — тот же интент, что /zaimy-s-plohoj-ki/ (текст влит туда).
<IfModule mod_rewrite.c>
RewriteRule ^zaimy-s-prosrochkami/?$ https://%{HTTP_HOST}/zaimy-s-plohoj-ki/ [R=301,L]
</IfModule>

# --- 6. Старые статьи /credit/<slug>.html без редиректа ------------------------
# Страница собрана как /credit/<slug>/index.html. Внутренний rewrite (адрес в браузере не меняется)
# отдаёт её по старому URL — но только если такая папка с index.html реально существует.
<IfModule mod_rewrite.c>
RewriteCond %{DOCUMENT_ROOT}/credit/$1/index.html -f
RewriteRule ^credit/([^/]+)\.html$ credit/$1/index.html [L]
</IfModule>

# --- 7. Завершающий слэш --------------------------------------------------------
# /zaimy -> /zaimy/ (301), но только если такая страница есть; пути с расширением
# (.html, .css, .xml, ...) и существующие файлы не трогаем. Несуществующие адреса сразу идут в 404.
<IfModule mod_rewrite.c>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

# --- 8. Сжатие -------------------------------------------------------------------
# Brotli (если модуль есть) и gzip. Сжатый ответ второй фильтр уже не трогает.
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# --- 9. Кэш ----------------------------------------------------------------------
# Значения ставит mod_headers; порядок: общие правила по типу файла, затем исключение для /_astro/.
<IfModule mod_headers.c>
# HTML — коротко, с перепроверкой: правки на сайте видны быстро.
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=300, must-revalidate"
</FilesMatch>
# sitemap, robots, поисковый индекс, манифест — час.
<FilesMatch "\.(xml|txt|json|webmanifest)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
# Картинки и иконки вне /_astro/ (логотипы МФО, og, favicon) — неделя.
<FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
# /_astro/*: имена файлов содержат хеш содержимого — кэшируем навсегда.
# (<If> применяется после FilesMatch и перекрывает правила выше.)
<If "%{REQUEST_URI} =~ m#^/_astro/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
</IfModule>
