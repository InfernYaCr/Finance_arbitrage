# Переменные читаются на этапе СБОРКИ (npm run build). Скопируйте в .env или задайте в окружении.
# Все PUBLIC_* попадают в HTML — секретов здесь быть не должно.

# Адрес сайта (canonical, sitemap, og:url). Боевой: https://rencredit-online.ru
# Тестовый поддомен: https://test.rencredit-online.ru
SITE_URL=https://rencredit-online.ru

# true -> на всех страницах <meta name="robots" content="noindex, nofollow">,
# robots.txt = "Disallow: /" (без Sitemap). Для тестового поддомена. На боевом — пусто или false.
PUBLIC_NOINDEX=

# Номер счётчика Яндекс Метрики (только цифры). Пусто или PUBLIC_NOINDEX=true -> счётчик и полоса согласия на cookie не выводятся.
# Задан -> полоса согласия над шапкой; счётчик грузится ТОЛЬКО после «Принять» (152-ФЗ, ст. 9).
# Выбор хранится в localStorage 'fk-consent'; отозвать — на /politika-konfidencialnosti/#cookie. Вебвизор выключен.
PUBLIC_METRIKA_ID=

# Коды подтверждения прав в Яндекс Вебмастере / Google Search Console (значение content метатега).
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=

# Почта для связи (футер, /o-proekte/, политика: запросы субъектов ПД). Пусто -> почта не выводится.
# Прод-сборка (без PUBLIC_NOINDEX=true) печатает предупреждение, если пусто это, PUBLIC_LEGAL_OWNER или PUBLIC_LEGAL_INN.
PUBLIC_CONTACT_EMAIL=

# Реквизиты владельца = оператора ПД (футер, /o-proekte/, политика конфиденциальности, JSON-LD Organization).
# Пустые поля не выводятся. Ничего не выдумываем.
PUBLIC_LEGAL_OWNER=
PUBLIC_LEGAL_INN=
PUBLIC_LEGAL_OGRN=
PUBLIC_LEGAL_ADDRESS=
