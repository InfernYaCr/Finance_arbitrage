{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./site/.env)",
      "Read(./site/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(printenv:*)",
      "PowerShell(git push:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|PowerShell",
        "hooks": [
          { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || exit 0; if command -v py >/dev/null 2>&1; then py \"$f\"; else python3 \"$f\"; fi" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/check.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\" --quick --hook", "timeout": 120 }
        ]
      }
    ]
  }
}
