  "content_html": "<div>\n<div>\n<div class=\"odprime\">\n<div>\n<div>\n<div>\n<div class=\"media\" data-media-tipe=\"ar16x9\">\n<div class=\"media__size\">\n<div class=\"photoview__open\" data-photoview-group=\"854401612\" data-photoview-src=\"https://cdnn.1prime.ru/img/84219/63/842196306_0:0:2400:1600_1440x900_80_0_1_e47806dd624fbeb889d2ee2de3f2bbb3.jpg\" data-photoview-image-id=\"842196305\" data-photoview-sharelink=\"https://1prime.ru/20250123/ukraina-854401612.html?share-img=842196305\" data-photoview-shareid=\"\"><img decoding=\"async\" src=\"http://lib.zaplata.ru/wp-content/uploads/2025/01/c2152590a2752289bd9f2fc9657fb491.jpeg\"  height=\"337\" width=\"600\" class=\"no-lazyload\" /></div>\n</p></div>\n<div class=\"media__after\">\n<div class=\"media__copyright\" data-nosnippet=\"true\"></div>\n</p></div>\n</p></div>\n</p></div>\n<div class=\"article__aggr\" data-visiblepush=\"no\" data-nosnippet=\"true\"></div>\n</p></div>\n<div class=\"article__body js-mediator-article mia-analytics\">\n<div class=\"article__block\" data-type=\"text\"> &#1053;&#1072;&#1094;&#1080;&#1086;&#1085;&#1072;&#1083;&#1100;&#1085;&#1099;&#1081; &#1073;&#1072;&#1085;&#1082; &#1059;&#1082;&#1088;&#1072;&#1080;&#1085;&#1099; (&#1053;&#1041;&#1059;) &#1079;&#1072;&#1103;&#1074;&#1080;&#1083; &#1074; &#1095;&#1077;&#1090;&#1074;&#1077;&#1088;&#1075; &#1086; &#1087;&#1086;&#1074;&#1099;&#1096;&#1077;&#1085;&#1080;&#1080; &#1091;&#1095;&#1077;&#1090;&#1085;&#1086;&#1081; &#1089;&#1090;&#1072;&#1074;&#1082;&#1080; &#1089; 13,5% &#1076;&#1086; 14,5% &#1075;&#1086;&#1076;&#1086;&#1074;&#1099;&#1093;. </div>\n</p></div>\n<div class=\"article__block\" data-type=\"text\">\n<div class=\"article__text\">&ldquo;&#1055;&#1088;&#1072;&#1074;&#1083;&#1077;&#1085;&#1080;&#1077; &#1053;&#1041;&#1059; &#1087;&#1086;&#1074;&#1099;&#1089;&#1080;&#1083;&#1086; &#1091;&#1095;&#1077;&#1090;&#1085;&#1091;&#1102; &#1089;&#1090;&#1072;&#1074;&#1082;&#1091; &#1076;&#1086; 14,5% &#1075;&#1086;&#1076;&#1086;&#1074;&