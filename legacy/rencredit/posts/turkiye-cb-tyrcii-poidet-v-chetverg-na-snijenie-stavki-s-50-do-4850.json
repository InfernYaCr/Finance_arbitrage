  "content_html": "<div>\n<div>\n<div class=\"odprime\">\n<div>\n<div>\n<div>\n<div class=\"media\" data-media-tipe=\"ar16x9\">\n<div class=\"media__size\">\n<div class=\"photoview__open\" data-photoview-group=\"853877013\" data-photoview-src=\"https://cdnn.1prime.ru/img/84138/52/841385229_0:0:1280:576_1440x900_80_1_1_e04dbe52fc42d225e7467cfe8f79cb4b.jpg\" data-photoview-image-id=\"841385228\" data-photoview-sharelink=\"https://1prime.ru/20241226/turtsiya-853877013.html?share-img=841385228\" data-photoview-shareid=\"\"><img decoding=\"async\" src=\"http://lib.zaplata.ru/wp-content/uploads/2024/12/01573badee117afbff20df648a5ecdcc.jpg\"  height=\"337\" width=\"600\" class=\"no-lazyload\" /></div>\n</p></div>\n<div class=\"media__after\">\n<div class=\"media__copyright\" data-nosnippet=\"true\"></div>\n</p></div>\n</p></div>\n</p></div>\n<div class=\"article__aggr\" data-visiblepush=\"no\" data-nosnippet=\"true\"></div>\n</p></div>\n<div class=\"article__body js-mediator-article mia-analytics\">\n<div class=\"article__block\" data-type=\"text\"> &#1062;&#1077;&#1085;&#1090;&#1088;&#1072;&#1083;&#1100;&#1085;&#1099;&#1081; &#1073;&#1072;&#1085;&#1082; &#1058;&#1091;&#1088;&#1094;&#1080;&#1080; &#1085;&#1072; &#1079;&#1072;&#1089;&#1077;&#1076;&#1072;&#1085;&#1080;&#1080; &#1074; &#1095;&#1077;&#1090;&#1074;&#1077;&#1088;&#1075; &#1087;&#1086;&#1081;&#1076;&#1077;&#1090; &#1085;&#1072; &#1089;&#1085;&#1080;&#1078;&#1077;&#1085;&#1080;&#1077; &#1082;&#1083;&#1102;&#1095;&#1077;&#1074;&#1086;&#1081; &#1089;&#1090;&#1072;&#1074;&#1082;&#1080; &#1085;&#1072; 150 &#1073;&#1072;&#1079;&#1080;&#1089;&#1085;&#1099;&#1093; &#1087;&#1091;&#1085;&#1082;&#1090;&#1086;&#1074;, &#1089; 50 &#1076;&#1086; 48,50 &#1087;&#1088;&#1086;&#1094;&#1077;&#1085;&#1090;&#1072;, &#1089;&#1086;&#1086;&#1073;&#1097;&#1080;&#1083;&#1072; &#1087;&#1088;&#1086;&#1087;&#1088;&#1072;&#1074;&#1080;&#1090;&#1077;&#1083;&#1100;&#1089;&#1090;&#1074;&#1077;&#1085;&#1085;&#1072;&#1103; &#1075;&#1072;&#1079;&#1