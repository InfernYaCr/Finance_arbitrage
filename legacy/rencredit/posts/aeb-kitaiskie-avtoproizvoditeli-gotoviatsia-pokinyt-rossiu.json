  "content_html": "<div>\n<div>\n<div class=\"odprime\">\n<div>\n<div>\n<div>\n<div class=\"media\" data-media-tipe=\"ar16x9\">\n<div class=\"media__size\">\n<div class=\"photoview__open\" data-photoview-group=\"854205880\" data-photoview-src=\"https://cdnn.1prime.ru/img/83663/96/836639687_0:0:2200:1448_1440x900_80_0_1_91badbad95a273bf5a30b26868d56c0f.jpg\" data-photoview-image-id=\"836639686\" data-photoview-sharelink=\"https://1prime.ru/20250115/kitayskie-854205880.html?share-img=836639686\" data-photoview-shareid=\"\"><img decoding=\"async\" src=\"http://lib.zaplata.ru/wp-content/uploads/2025/01/a4e5e3d8ef687e1d4e0e3aaa3713bdf9.webp\" height=\"337\" width=\"600\" class=\"no-lazyload\" /></div>\n</p></div>\n<div class=\"media__after\">\n<div class=\"media__copyright\" data-nosnippet=\"true\"></div>\n</p></div>\n</p></div>\n</p></div>\n<div class=\"article__aggr\" data-visiblepush=\"no\" data-nosnippet=\"true\"></div>\n</p></div>\n<div class=\"article__body js-mediator-article mia-analytics\">\n<div class=\"article__block\" data-type=\"text\">&#1040;&#1089;&#1089;&#1086;&#1094;&#1080;&#1072;&#1094;&#1080;&#1103; &#1077;&#1074;&#1088;&#1086;&#1087;&#1077;&#1081;&#1089;&#1082;&#1086;&#1075;&#1086; &#1073;&#1080;&#1079;&#1085;&#1077;&#1089;&#1072; &#1087;&#1088;&#1086;&#1075;&#1085;&#1086;&#1079;&#1080;&#1088;&#1091;&#1077;&#1090; &#1091;&#1093;&#1086;&#1076; &#1082;&#1080;&#1090;&#1072;&#1081;&#1089;&#1082;&#1080;&#1093; &#1072;&#1074;&#1090;&#1086;&#1073;&#1088;&#1077;&#1085;&#1076;&#1086;&#1074; &#1080;&#1079; &#1056;&#1086;&#1089;&#1089;&#1080;&#1080; &#1074; 2025 &#1075;&#1086;&#1076;&#1091;, &#1087;&#1080;&#1096;&#1077;&#1090; &ldquo;&#1040;&#1074;&#1090;&#1086;&#1074;&#1079;&#1075;&#1083;&#1103;&#1076;&rdquo; &#1089;&#1086; &#1089;&#1089;&#1099;&#1083;&#1082;&#1086;&#1081; &#1085;&#1072; &#1087;&#1088;&#1086;&#1075;&#1085;&#1086;&#1079; &#1040;&#1089;&#1089;&#1086;&#1094;&#1080;&#1072;&#1094;&#1080;&#1080; &#1077;&#1074;&#1088;&#1086;&#1087;&#1077;&#1081;&#1089