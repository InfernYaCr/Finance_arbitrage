---
import { loadAllPages } from '../data/loadPages';
import { getPageType, pathToSlug } from '../lib/routing';
import { deriveSeoFields } from '../lib/seo';
import { buildJsonLd } from '../lib/schema';

import HomeLayout from '../layouts/HomeLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import ServiceLayout from '../layouts/ServiceLayout.astro';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import FaqLayout from '../layouts/FaqLayout.astro';
import DictionaryLayout from '../layouts/DictionaryLayout.astro';
import ContactLayout from '../layouts/ContactLayout.astro';

export async function getStaticPaths() {
  const pages = loadAllPages();
  const contactPath = import.meta.env.PUBLIC_CONTACT_PATH ?? '/kontakty/';

  // Precompute which paths have child pages (for universal archive detection)
  const allPaths = new Set(pages.map((p) => p.path));
  const pathsWithChildren = new Set<string>();
  for (const p of pages) {
    const parts = p.path.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
    if (parts.length >= 2) {
      const parentPath = '/' + parts.slice(0, -1).join('/') + '/';
      if (allPaths.has(parentPath)) pathsWithChildren.add(parentPath);
    }
  }

  return pages.map((page) => {
    const hints = { hasChildren: pathsWithChildren.has(page.path), contactPath };
    const pageType = getPageType(page.path, page.section, hints);
    const seo = deriveSeoFields(page, pageType);
    const jsonLd = buildJsonLd(page, seo, pageType);
    const slug = pathToSlug(page.path);

    return {
      params: { slug },
      props: { page, pageType, seo, jsonLd },
    };
  });
}

const { page, pageType, seo, jsonLd } = Astro.props;

const layoutProps = { page, seo, jsonLd, pageType };
---

{pageType === 'home'               && <HomeLayout       {...layoutProps} />}
{pageType === 'article'            && <ArticleLayout    {...layoutProps} />}
{pageType === 'archive'            && <ArchiveLayout    {...layoutProps} />}
{pageType === 'service'            && <ServiceLayout    {...layoutProps} />}
{pageType === 'portfolio_archive'  && <PortfolioLayout  {...layoutProps} />}
{pageType === 'portfolio_case'     && <PortfolioLayout  {...layoutProps} />}
{pageType === 'faq'                && <FaqLayout        {...layoutProps} />}
{pageType === 'dictionary_archive' && <ArchiveLayout    {...layoutProps} />}
{pageType === 'dictionary_article' && <DictionaryLayout {...layoutProps} />}
{pageType === 'contact'            && <ContactLayout    {...layoutProps} />}
{pageType === 'company'            && <ArticleLayout    {...layoutProps} />}
{pageType === 'content_page'       && <ArticleLayout    {...layoutProps} />}
