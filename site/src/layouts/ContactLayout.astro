---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { FullPage, SeoFields, PageType } from '../data/types';
import { siteConfig } from '../data/siteConfig';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { data } = page;
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <div class="contact-page">
    <div class="container">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="contact-page__header">
        {seo.h1 && <h1 class="contact-page__title">{seo.h1}</h1>}
        {seo.description && <p class="contact-page__lead">{seo.description}</p>}
      </header>

      <div class="contact-page__grid">
        <div class="contact-page__content">
          {data.content_html && (
            <div class="prose" set:html={data.content_html} />
          )}
        </div>

        <aside class="contact-page__form-wrap">
          <div class="contact-card">
            <h2 class="contact-card__title">Написать нам</h2>

            <form
              class="contact-form"
              name="contact"
              method="POST"
              action="/thanks/"
              novalidate
            >
              <!-- Honeypot anti-spam -->
              <input type="text" name="_honey" tabindex="-1" aria-hidden="true" style="display:none" />

              <div class="contact-form__field">
                <label for="cf-name">Имя</label>
                <input type="text" id="cf-name" name="name" required autocomplete="name" />
              </div>

              <div class="contact-form__field">
                <label for="cf-email">Email</label>
                <input type="email" id="cf-email" name="email" required autocomplete="email" />
              </div>

              <div class="contact-form__field">
                <label for="cf-message">Сообщение</label>
                <textarea id="cf-message" name="message" rows="5" required></textarea>
              </div>

              <button type="submit" class="contact-form__submit">Отправить</button>

              <p class="contact-form__note">
                Нажимая «Отправить», вы соглашаетесь с обработкой персональных данных.
              </p>
            </form>
          </div>

          {(siteConfig.company.phone || siteConfig.company.email) && (
            <div class="contact-details">
              {siteConfig.company.phone && (
                <p>
                  <strong>Телефон:</strong>{' '}
                  <a href={`tel:${siteConfig.company.phone}`}>{siteConfig.company.phone}</a>
                </p>
              )}
              {siteConfig.company.email && (
                <p>
                  <strong>Email:</strong>{' '}
                  <a href={`mailto:${siteConfig.company.email}`}>{siteConfig.company.email}</a>
                </p>
              )}
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.contact-page {
  padding: var(--space-10) 0 var(--space-section);
}

.contact-page__header {
  margin-bottom: var(--space-10);
  max-width: var(--container-sm);
}

.contact-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.contact-page__lead {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
}

.contact-page__grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: var(--space-12);
  align-items: start;
}

/* Form card */
.contact-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
}

.contact-card__title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  margin-bottom: var(--space-6);
}

.contact-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.contact-form__field label {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-muted);
}

.contact-form__field input,
.contact-form__field textarea {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-bg);
  transition: border-color var(--duration-fast);
  width: 100%;
  resize: vertical;
}

.contact-form__field input:focus,
.contact-form__field textarea:focus {
  outline: none;
  border-color: var(--color-accent);
}

.contact-form__submit {
  width: 100%;
  background: var(--color-accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out);
  margin-bottom: var(--space-3);
}

.contact-form__submit:hover {
  background: var(--color-accent-hover);
}

.contact-form__note {
  font-size: var(--text-xs);
  color: var(--color-text-light);
}

.contact-details {
  margin-top: var(--space-5);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

@media (max-width: 900px) {
  .contact-page__grid {
    grid-template-columns: 1fr;
  }
}
</style>
