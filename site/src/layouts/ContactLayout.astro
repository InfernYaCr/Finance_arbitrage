---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { FullPage, SeoFields, PageType } from '../data/types';
import { siteConfig } from '../data/siteConfig';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { contactForm } = siteConfig;
const formAction = contactForm.action || '/mail.php';
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <div class="contact-page">
    <div class="container">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="contact-page__header">
        {seo.h1 && <h1 class="contact-page__title">{seo.h1}</h1>}
        {seo.description && <p class="contact-page__lead">{seo.description}</p>}
      </header>

      <div class="contact-page__grid">
        <div class="contact-form-col">
          <div class="contact-card">
            <h2 class="contact-card__title">Написать нам</h2>
            <form
              class="contact-form"
              id="contact-form"
              name="contact"
              method="POST"
              action={formAction}
              novalidate
            >
              <input type="hidden" name="_subject" value={contactForm.subject} />
              {contactForm.redirect && <input type="hidden" name="_next" value={contactForm.redirect} />}
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
              <div class="contact-form__field">
                <label for="cf-name">Имя <span class="contact-form__req" aria-hidden="true">*</span></label>
                <input type="text" id="cf-name" name="name" required autocomplete="name" placeholder="Иван Иванов" />
                <span class="contact-form__error" id="err-name"></span>
              </div>
              <div class="contact-form__field">
                <label for="cf-phone">Телефон <span class="contact-form__req" aria-hidden="true">*</span></label>
                <input type="tel" id="cf-phone" name="phone" required autocomplete="tel" placeholder="+7 (___) ___-__-__" maxlength="18" inputmode="tel" />
                <span class="contact-form__error" id="err-phone"></span>
              </div>
              <div class="contact-form__field">
                <label for="cf-email">Email</label>
                <input type="email" id="cf-email" name="email" autocomplete="email" placeholder="example@mail.ru" />
                <span class="contact-form__error" id="err-email"></span>
              </div>
              <div class="contact-form__field">
                <label for="cf-message">Сообщение <span class="contact-form__req" aria-hidden="true">*</span></label>
                <textarea id="cf-message" name="message" rows="5" required placeholder="Расскажите о вашем проекте..."></textarea>
                <span class="contact-form__error" id="err-message"></span>
              </div>
              <button type="submit" class="contact-form__submit">Отправить</button>
              <p class="contact-form__note">
                * — обязательные поля. Нажимая «Отправить», вы соглашаетесь с обработкой персональных данных.
              </p>
            </form>
          </div>
        </div>

        <aside class="contact-info-col">
          <div class="contact-info-card">
            <h2 class="contact-info-card__title">Контактная информация</h2>
            {siteConfig.company.worktime && (
              <div class="contact-info-card__row">
                <span class="contact-info-card__icon" aria-hidden="true">🕐</span>
                <span>{siteConfig.company.worktime}</span>
              </div>
            )}
            {siteConfig.company.phone && (
              <div class="contact-info-card__row">
                <span class="contact-info-card__icon" aria-hidden="true">📞</span>
                <a href={`tel:${siteConfig.company.phoneHref}`}>{siteConfig.company.phone}</a>
              </div>
            )}
            {siteConfig.company.email && (
              <div class="contact-info-card__row">
                <span class="contact-info-card__icon" aria-hidden="true">✉️</span>
                <a href={`mailto:${siteConfig.company.email}`}>{siteConfig.company.email}</a>
              </div>
            )}
            {siteConfig.company.address && siteConfig.company.address !== 'Адрес уточняется' && (
              <div class="contact-info-card__row">
                <span class="contact-info-card__icon" aria-hidden="true">📍</span>
                <span>{siteConfig.company.address}</span>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.contact-page {
  padding: var(--space-10) 0 var(--space-section);
}

.contact-page__header {
  margin-bottom: var(--space-10);
  max-width: var(--container-sm);
}

.contact-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.contact-page__lead {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
}

.contact-page__grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--space-12);
  align-items: start;
}

.contact-info-col {
  position: sticky;
  top: calc(var(--header-height, 7rem) + var(--space-6));
}

/* Info card */
.contact-info-card {
  background: var(--color-accent);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-7);
  color: #fff;
}

.contact-info-card__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  margin-bottom: var(--space-5);
  opacity: 0.85;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: var(--text-xs);
}

.contact-info-card__row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  padding: var(--space-2) 0;
  border-bottom: 1px solid rgba(255,255,255,0.15);
  color: #fff;
}

.contact-info-card__row:last-child {
  border-bottom: 0;
}

.contact-info-card__icon {
  flex-shrink: 0;
  margin-top: 1px;
}

.contact-info-card__row a {
  color: #fff;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.contact-info-card__row a:hover {
  opacity: 0.8;
  color: #fff;
}

/* Form card */
.contact-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
}

.contact-card__title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  margin-bottom: var(--space-6);
}

.contact-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.contact-form__field label {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-muted);
}

.contact-form__field input,
.contact-form__field textarea {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-base);
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-bg);
  transition: border-color var(--duration-fast);
  width: 100%;
  resize: vertical;
}

.contact-form__field input:focus,
.contact-form__field textarea:focus {
  outline: none;
  border-color: var(--color-accent);
}

.contact-form__submit {
  width: 100%;
  background: var(--color-accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out);
  margin-bottom: var(--space-3);
}

.contact-form__submit:hover {
  background: var(--color-accent-hover);
}

.contact-form__note {
  font-size: var(--text-xs);
  color: var(--color-text-light);
}

.contact-details {
  margin-top: var(--space-5);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

@media (max-width: 900px) {
  .contact-page__grid {
    grid-template-columns: 1fr;
  }
}

.contact-form__req {
  color: var(--color-accent);
}

.contact-form__error {
  font-size: var(--text-xs);
  color: #d32f2f;
  min-height: 1.2em;
  display: block;
}

.contact-form__field input.is-invalid,
.contact-form__field textarea.is-invalid {
  border-color: #d32f2f;
}
</style>

<script>
(function () {
  const form = document.getElementById('contact-form');
  if (!form) return;

  // Phone mask: formats to +7 (XXX) XXX-XX-XX
  const phoneInput = document.getElementById('cf-phone');
  if (phoneInput) {
    phoneInput.addEventListener('input', function () {
      let digits = this.value.replace(/\D/g, '');
      if (digits.startsWith('8')) digits = '7' + digits.slice(1);
      if (digits.startsWith('7')) digits = digits.slice(1);
      digits = digits.slice(0, 10);
      let formatted = '+7';
      if (digits.length > 0) formatted += ' (' + digits.slice(0, 3);
      if (digits.length >= 3) formatted += ') ' + digits.slice(3, 6);
      if (digits.length >= 6) formatted += '-' + digits.slice(6, 8);
      if (digits.length >= 8) formatted += '-' + digits.slice(8, 10);
      this.value = formatted;
    });

    phoneInput.addEventListener('keydown', function (e) {
      if (e.key === 'Backspace' && this.value === '+7') {
        e.preventDefault();
        this.value = '';
      }
    });

    phoneInput.addEventListener('focus', function () {
      if (!this.value) this.value = '+7 (';
    });

    phoneInput.addEventListener('blur', function () {
      if (this.value === '+7 (') this.value = '';
    });
  }

  function showError(fieldId, errId, msg) {
    const field = document.getElementById(fieldId);
    const err = document.getElementById(errId);
    if (field) field.classList.add('is-invalid');
    if (err) err.textContent = msg;
  }

  function clearError(fieldId, errId) {
    const field = document.getElementById(fieldId);
    const err = document.getElementById(errId);
    if (field) field.classList.remove('is-invalid');
    if (err) err.textContent = '';
  }

  function validatePhone(val) {
    const digits = val.replace(/\D/g, '');
    return digits.length === 11 && digits.startsWith('7');
  }

  function validateEmail(val) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val.trim());
  }

  // Live validation on blur
  document.getElementById('cf-name')?.addEventListener('blur', function () {
    this.value.trim() ? clearError('cf-name', 'err-name') : showError('cf-name', 'err-name', 'Введите ваше имя');
  });

  document.getElementById('cf-phone')?.addEventListener('blur', function () {
    if (!this.value.trim()) {
      showError('cf-phone', 'err-phone', 'Введите номер телефона');
    } else if (!validatePhone(this.value)) {
      showError('cf-phone', 'err-phone', 'Введите полный номер: +7 (XXX) XXX-XX-XX');
    } else {
      clearError('cf-phone', 'err-phone');
    }
  });

  document.getElementById('cf-email')?.addEventListener('blur', function () {
    if (this.value.trim() && !validateEmail(this.value)) {
      showError('cf-email', 'err-email', 'Некорректный email, например: name@mail.ru');
    } else {
      clearError('cf-email', 'err-email');
    }
  });

  document.getElementById('cf-message')?.addEventListener('blur', function () {
    this.value.trim() ? clearError('cf-message', 'err-message') : showError('cf-message', 'err-message', 'Напишите сообщение');
  });

  form.addEventListener('submit', function (e) {
    let valid = true;

    const name = document.getElementById('cf-name');
    if (!name?.value.trim()) { showError('cf-name', 'err-name', 'Введите ваше имя'); valid = false; }
    else clearError('cf-name', 'err-name');

    const phone = document.getElementById('cf-phone');
    if (!phone?.value.trim()) { showError('cf-phone', 'err-phone', 'Введите номер телефона'); valid = false; }
    else if (!validatePhone(phone.value)) { showError('cf-phone', 'err-phone', 'Введите полный номер: +7 (XXX) XXX-XX-XX'); valid = false; }
    else clearError('cf-phone', 'err-phone');

    const email = document.getElementById('cf-email');
    if (email?.value.trim() && !validateEmail(email.value)) { showError('cf-email', 'err-email', 'Некорректный email, например: name@mail.ru'); valid = false; }
    else clearError('cf-email', 'err-email');

    const message = document.getElementById('cf-message');
    if (!message?.value.trim()) { showError('cf-message', 'err-message', 'Напишите сообщение'); valid = false; }
    else clearError('cf-message', 'err-message');

    if (!valid) {
      e.preventDefault();
      form.querySelector('.is-invalid')?.focus();
    }
  });
})();
</script>
