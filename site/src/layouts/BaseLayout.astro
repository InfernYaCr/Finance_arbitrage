---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SeoFields } from '../data/types';

interface Props {
  seo: SeoFields;
  jsonLd: object[];
  currentPath?: string;
}

const { seo, jsonLd, currentPath } = Astro.props;
const rawTheme = import.meta.env.PUBLIC_THEME || 'alpha';
const theme = /^[a-z0-9_-]+$/.test(rawTheme) ? rawTheme : 'alpha';
---

<!doctype html>
<html lang="ru" data-theme={theme}>
  <head>
    <SeoHead seo={seo} />
    <JsonLd graph={jsonLd} />
    <Analytics />
    <ViewTransitions />
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      document.querySelectorAll<HTMLImageElement>('img[src]').forEach((img) => {
        img.onerror = function () {
          (this as HTMLImageElement).src = '/images/placeholder.svg';
          (this as HTMLImageElement).onerror = null;
        };
      });
    </script>
  </body>
</html>
