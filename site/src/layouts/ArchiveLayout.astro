---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDescendantPages, getImmediateChildPages } from '../data/loadPages';
import { siteConfig } from '../data/siteConfig';
import type { FullPage, SeoFields, PageType } from '../data/types';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { data } = page;

// Niche-aware catalog heading (F6.3)
const _seg = page.path.replace(/^\//, '').split('/')[0] ?? '';
const catalogHeading = siteConfig.sectionLabels[_seg] ?? 'Разделы и материалы';

const isRatingsArchive = page.path === '/ratings/';

function getCategoryFromPath(path: string): string {
  if (/debetov|cashback|virtual|mili|taksi|pensioneram|protsentami-na-ostatok/.test(path)) return 'debit';
  if (/ipoteka/.test(path)) return 'mortgage';
  if (/avtokredit/.test(path)) return 'auto';
  if (/kredit|refinansirovan|nalichnyh|aliekspress|sberbanka/.test(path)) return 'credit';
  return 'all';
}

const filterTabs = [
  { id: 'all', label: 'Все' },
  { id: 'debit', label: 'Дебетовые карты' },
  { id: 'credit', label: 'Кредитные карты' },
  { id: 'mortgage', label: 'Ипотека' },
  { id: 'auto', label: 'Автокредиты' },
];
const isFaqArchive = page.path === '/faq/';
const isPricingArchive = page.path === '/stoimost-uslug/';
const directChildren = getImmediateChildPages(page.path);
const descendantPages = getDescendantPages(page.path);
const hasSourceCatalog = data.content_html.includes('serv-blocks') || data.content_html.includes('serv-items');
const showGeneratedCatalog = directChildren.length > 0 && !hasSourceCatalog;
const groupedChildren = directChildren.map((child) => ({
  page: child,
  children: descendantPages
    .filter((candidate) => candidate.path !== child.path && candidate.path.startsWith(child.path))
    .slice(0, 8),
}));
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <section class="archive-page">
    <div class="container">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="archive-page__header">
        {seo.h1 && <h1 class="archive-page__title">{seo.h1}</h1>}
        {seo.description && <p class="archive-page__desc">{seo.description}</p>}
      </header>

      {data.content_html && !showGeneratedCatalog && (
        <div class="prose archive-page__body" set:html={data.content_html} />
      )}

      {showGeneratedCatalog && isFaqArchive && (
        <section class="archive-page__catalog" aria-label="Вопросы и ответы">
          <div class="faq-accordion">
            {directChildren.map((child) => (
              <details class="faq-item">
                <summary class="faq-item__q">
                  <span>{child.h1 || child.title}</span>
                  <svg class="faq-item__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="faq-item__body">
                  {child.description && <p>{child.description}</p>}
                  <a href={child.path} class="faq-item__link">Читать полный ответ →</a>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {showGeneratedCatalog && isPricingArchive && (() => {
        const tariffs = directChildren.filter(c => c.path.includes('tarif'));
        const others = directChildren.filter(c => !c.path.includes('tarif'));
        return (
          <section class="archive-page__catalog">
            {tariffs.length > 0 && (
              <>
                <h2 class="archive-page__catalog-title">Тарифы SEO-продвижения</h2>
                <div class="pricing-grid">
                  {tariffs.map((t) => (
                    <article class="pricing-card">
                      <div class="pricing-card__name">{t.h1 || t.title}</div>
                      {t.description && <p class="pricing-card__desc">{t.description}</p>}
                      <a href={t.path} class="pricing-card__btn">Подробнее о тарифе</a>
                    </article>
                  ))}
                </div>
              </>
            )}
            {others.length > 0 && (
              <>
                <h2 class="archive-page__catalog-title" style="margin-top: var(--space-12)">Полезная информация</h2>
                <div class="archive-page__grid">
                  {others.map((c) => (
                    <article class="archive-card">
                      <a class="archive-card__title" href={c.path}>{c.h1 || c.title}</a>
                      {c.description && <p class="archive-card__desc">{c.description}</p>}
                    </article>
                  ))}
                </div>
              </>
            )}
          </section>
        );
      })()}

      {showGeneratedCatalog && !isFaqArchive && !isPricingArchive && (
        <section class="archive-page__catalog" aria-labelledby="archive-catalog-title">
          {isRatingsArchive && (
            <div class="archive-filter" role="tablist" aria-label="Фильтр рейтингов">
              {filterTabs.map((tab) => (
                <button
                  class="archive-filter__tab"
                  data-tab={tab.id}
                  role="tab"
                  aria-selected={tab.id === 'all' ? 'true' : 'false'}
                >
                  {tab.label}
                </button>
              ))}
            </div>
          )}

          {!isRatingsArchive && (
            <h2 id="archive-catalog-title" class="archive-page__catalog-title">
              {catalogHeading}
            </h2>
          )}

          <div class="archive-page__grid" id="archive-grid">
            {groupedChildren.map((group) => (
              <article
                class="archive-card"
                data-category={isRatingsArchive ? getCategoryFromPath(group.page.path) : undefined}
              >
                <a class="archive-card__title" href={group.page.path}>
                  {group.page.h1 || group.page.title}
                </a>

                {group.page.description && (
                  <p class="archive-card__desc">{group.page.description}</p>
                )}

                {group.children.length > 0 && (
                  <ul class="archive-card__links" role="list">
                    {group.children.map((child) => (
                      <li>
                        <a href={child.path}>{child.h1 || child.title}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <div class="archive-page__cta">
        <div class="archive-cta-banner">
          <div class="archive-cta-banner__text">
            <p class="archive-cta-banner__title">{siteConfig.niche.ctaQuestion}</p>
            <p class="archive-cta-banner__desc">{siteConfig.niche.sidebarDesc}</p>
          </div>
          <a href={siteConfig.contactPath} class="archive-cta-banner__btn">{siteConfig.niche.ctaBtn}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.archive-page {
  padding: var(--space-10) 0 var(--space-section);
}

.archive-page__header {
  margin-bottom: var(--space-10);
  max-width: var(--container-sm);
}

.archive-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.archive-page__desc {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

.archive-page__body {
  max-width: none;
}

.archive-page__catalog {
  margin-top: var(--space-12);
}

.archive-page__catalog-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  margin-bottom: var(--space-6);
}

.archive-page__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: var(--space-5);
}

.archive-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  background: var(--color-bg);
}

.archive-card__title {
  display: inline-block;
  color: var(--color-text);
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-tight);
  text-decoration: none;
  margin-bottom: var(--space-3);
}

.archive-card__title:hover {
  color: var(--color-accent);
}

.archive-card__desc {
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-4);
}

.archive-card__links {
  list-style: none;
  display: grid;
  gap: var(--space-2);
}

.archive-card__links a {
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
}

/* Pricing grid */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--space-5);
  margin-top: var(--space-6);
}

.pricing-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-6);
  border: 2px solid var(--color-accent);
  border-radius: var(--radius-xl);
  background: var(--color-bg);
}

.pricing-card__name {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  line-height: var(--leading-snug);
}

.pricing-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  flex: 1;
}

.pricing-card__btn {
  display: inline-block;
  margin-top: var(--space-2);
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  text-decoration: none;
  text-align: center;
  transition: background var(--duration-fast) var(--ease-out);
}

.pricing-card__btn:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

/* FAQ Accordion */
.faq-accordion {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: var(--space-8);
}

.faq-item {
  border-bottom: 1px solid var(--color-border);
}

.faq-item:last-child {
  border-bottom: 0;
}

.faq-item__q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-6);
  cursor: pointer;
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--color-text);
  list-style: none;
  user-select: none;
  background: var(--color-bg);
  transition: background var(--duration-fast);
}

.faq-item__q::-webkit-details-marker {
  display: none;
}

.faq-item__q:hover {
  background: var(--color-surface);
}

.faq-item__chevron {
  flex-shrink: 0;
  color: var(--color-text-muted);
  transition: transform var(--duration-fast) var(--ease-out);
}

.faq-item[open] > .faq-item__q .faq-item__chevron {
  transform: rotate(180deg);
  color: var(--color-accent);
}

.faq-item[open] > .faq-item__q {
  color: var(--color-accent);
}

.faq-item__body {
  padding: 0 var(--space-6) var(--space-5);
  background: var(--color-surface);
}

.faq-item__body p {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-3);
}

.faq-item__link {
  font-size: var(--text-sm);
  color: var(--color-accent);
  text-decoration: none;
  font-weight: var(--weight-medium);
  transition: opacity var(--duration-fast);
}

.faq-item__link:hover {
  opacity: 0.8;
}

/* Filter tabs */
.archive-filter {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-6);
}

.archive-filter__tab {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full, 999px);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  cursor: pointer;
  transition: background var(--duration-fast), color var(--duration-fast), border-color var(--duration-fast);
  white-space: nowrap;
}

.archive-filter__tab:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.archive-filter__tab[aria-selected="true"] {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: #fff;
}

/* CTA banner */
.archive-page__cta {
  margin-top: var(--space-12);
}

.archive-cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-lg);
  padding: var(--space-6) var(--space-8);
}

.archive-cta-banner__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  margin-bottom: var(--space-1);
}

.archive-cta-banner__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.archive-cta-banner__btn {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-md);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background var(--duration-fast) var(--ease-out);
}

.archive-cta-banner__btn:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

@media (max-width: 600px) {
  .archive-cta-banner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.archive-filter__tab');
  if (tabs.length > 0) {
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const active = tab.dataset.tab ?? 'all';
        tabs.forEach((t) => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
        document.querySelectorAll<HTMLElement>('#archive-grid .archive-card').forEach((card) => {
          const cat = card.dataset.category ?? 'all';
          card.style.display = active === 'all' || cat === active ? '' : 'none';
        });
      });
    });
  }
</script>
