---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PromoSlot from '../components/PromoSlot.astro';
import type { FullPage, SeoFields, PageType } from '../data/types';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd, pageType } = Astro.props;
const { data } = page;
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <article class="article-page">
    <div class="container container--md">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="article-page__header">
        {seo.h1 && <h1 class="article-page__title">{seo.h1}</h1>}
        {(seo.datePublished || seo.dateModified) && (
          <div class="article-page__meta">
            {seo.dateModified && (
              <time datetime={seo.dateModified} class="article-page__date">
                Обновлено: {new Date(seo.dateModified).toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )}
          </div>
        )}
      </header>

      {data.excerpt_html && (
        <div class="article-page__excerpt" set:html={data.excerpt_html} />
      )}

      <div class="prose article-page__body" set:html={data.content_html} />

      <PromoSlot placement="article_footer" section={page.section} path={page.path} pageType={pageType} />

      <div class="article-page__cta">
        <p class="article-page__cta-text">Остались вопросы по SEO-продвижению?</p>
        <a href="/kontakty/" class="article-page__cta-btn">Задать вопрос специалисту</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
.article-page {
  padding: var(--space-10) 0 var(--space-section);
}

.article-page__header {
  margin-bottom: var(--space-8);
}

.article-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  color: var(--color-text);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.article-page__meta {
  display: flex;
  gap: var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.article-page__excerpt {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-8);
  border-bottom: 1px solid var(--color-border);
}

.article-page__body {
  margin-top: var(--space-6);
}

.article-page__cta {
  margin-top: var(--space-10);
  padding: var(--space-6) var(--space-8);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  flex-wrap: wrap;
}

.article-page__cta-text {
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--color-text);
}

.article-page__cta-btn {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-md);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background var(--duration-fast) var(--ease-out);
}

.article-page__cta-btn:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

@media (max-width: 600px) {
  .article-page__cta {
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-5);
  }
}
</style>
