---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PromoSlot from '../components/PromoSlot.astro';
import RelatedPages from '../components/RelatedPages.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StatsBar from '../components/StatsBar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RatingQuickList from '../components/RatingQuickList.astro';
import OfferCard from '../components/OfferCard.astro';
import type { TocHeading } from '../components/TableOfContents.astro';
import { getImmediateChildPages, getRelatedPages } from '../data/loadPages';
import { siteConfig } from '../data/siteConfig';

import type { FullPage, SeoFields, PageType, Offer } from '../data/types';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd, pageType } = Astro.props;
const { data } = page;

// Get sibling pages for sidebar (parent's immediate children, excluding self)
const parentPath = '/' + page.path.replace(/^\//, '').split('/').slice(0, -2).join('/') + '/';
const siblings = parentPath.length > 1
  ? getImmediateChildPages(parentPath).filter((p) => p.path !== page.path).slice(0, 6)
  : [];
const hasSidebar = siblings.length >= 3;
const childPages = getImmediateChildPages(page.path);
const keyPoints = data.extracted?.key_points?.filter((point) => point.trim()) ?? [];
const relatedLinks = getRelatedPages(page.id);

// --- Table of Contents: parse h2 headings and inject IDs ---
function slugify(text: string): string {
  return text.trim().toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/[^a-zа-яё0-9\s]/gi, '')
    .replace(/\s+/g, '-')
    .substring(0, 60);
}

function injectHeadingIds(html: string): { html: string; headings: TocHeading[] } {
  const headings: TocHeading[] = [];
  const processed = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (full, attrs, inner) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    if (!text) return full;
    // If the h2 already has an id attribute, reuse it
    const existingId = attrs.match(/\bid="([^"]+)"/);
    if (existingId) {
      headings.push({ id: existingId[1], text });
      return full; // leave as-is
    }
    const id = slugify(text);
    headings.push({ id, text });
    return `<h2${attrs} id="${id}">${inner}</h2>`;
  });
  return { html: processed, headings };
}

const { html: processedContentHtml, headings: tocHeadings } =
  injectHeadingIds(data.content_html || '');

const { niche } = siteConfig;
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <article class="article-page">
    <div class={hasSidebar ? 'container article-page__with-sidebar' : 'container container--md'}>
      <div class="article-page__main">
        <Breadcrumbs crumbs={seo.breadcrumbs} />

        <header class="article-page__header">
          {seo.h1 && <h1 class="article-page__title">{seo.h1}</h1>}
          {(seo.datePublished || seo.dateModified) && (
            <div class="article-page__meta">
              {seo.dateModified && (
                <time datetime={seo.dateModified} class="article-page__date">
                  Обновлено: {new Date(seo.dateModified).toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
            </div>
          )}
        </header>

        {(data.excerpt_html || data.extracted?.summary) && (
          <div class="article-page__excerpt">
            {data.excerpt_html
              ? <Fragment set:html={data.excerpt_html} />
              : <p>{data.extracted!.summary}</p>
            }
          </div>
        )}

        <StatsBar stats={siteConfig.siteStats} />

        {keyPoints.length >= 2 && (
          <section class="article-summary" aria-labelledby="article-summary-title">
            <h2 id="article-summary-title" class="article-summary__title">Кратко о главном</h2>
            <ul class="article-summary__list" role="list">
              {keyPoints.map((point) => <li>{point}</li>)}
            </ul>
          </section>
        )}

        <RatingQuickList headings={tocHeadings} />
        <TableOfContents headings={tocHeadings} />

        {(data.extracted?.offers?.length ?? 0) > 0 && (
          <section class="offer-list" aria-label="Рейтинг продуктов">
            {data.extracted!.offers!.map((offer: Offer) => (
              <OfferCard offer={offer} ctaBaseUrl={siteConfig.legacyContent.sourceDomain} />
            ))}
          </section>
        )}

        <div class="prose article-page__body" set:html={processedContentHtml} />

        {childPages.length > 0 && (
          <nav class="article-children" aria-label="В этом разделе">
            <h2 class="article-children__heading">В этом разделе</h2>
            <ul class="article-children__list" role="list">
              {childPages.map((c) => (
                <li>
                  <a href={c.path} class="article-children__link">
                    <span>{c.h1 || c.title}</span>
                    <span class="article-children__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <FaqAccordion extracted={data.extracted} />

        <PromoSlot placement="article_footer" section={page.section} path={page.path} pageType={pageType} />

        {relatedLinks.length > 0 && <RelatedPages links={relatedLinks} />}

        <div class="article-page__cta">
          <p class="article-page__cta-text">{niche.ctaQuestion}</p>
          <a href={siteConfig.contactPath} class="article-page__cta-btn">{niche.ctaBtn}</a>
        </div>
      </div>

      {hasSidebar && (
        <aside class="article-sidebar">
          <div class="article-sidebar__block">
            <h2 class="article-sidebar__heading">Статьи по теме</h2>
            <ul class="article-sidebar__list" role="list">
              {siblings.map((s) => (
                <li>
                  <a href={s.path} class="article-sidebar__link">{s.h1 || s.title}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="article-sidebar__cta">
            <p class="article-sidebar__cta-title">{niche.sidebarTitle}</p>
            <p class="article-sidebar__cta-desc">{niche.sidebarDesc}</p>
            <a href={siteConfig.contactPath} class="article-sidebar__cta-btn">{niche.sidebarBtn}</a>
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
.article-page {
  padding: var(--space-10) 0 var(--space-section);
}

.article-page__header {
  margin-bottom: var(--space-8);
}

.article-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  color: var(--color-text);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.article-page__meta {
  display: flex;
  gap: var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.article-page__excerpt {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-8);
  border-bottom: 1px solid var(--color-border);
}

.article-page__body {
  margin-top: var(--space-6);
}

.article-page__cta {
  margin-top: var(--space-10);
  padding: var(--space-6) var(--space-8);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  flex-wrap: wrap;
}

.article-page__cta-text {
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--color-text);
}

.article-page__cta-btn {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-md);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background var(--duration-fast) var(--ease-out);
}

.article-page__cta-btn:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

@media (max-width: 600px) {
  .article-page__cta {
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-5);
  }
}

/* Child pages nav */
.article-children {
  margin-top: var(--space-10);
  padding: var(--space-6);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.article-children__heading {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.article-children__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.article-children__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.article-children__list li:last-child .article-children__link {
  border-bottom: 0;
}

.article-children__link:hover {
  color: var(--color-accent);
}

.article-children__arrow {
  flex-shrink: 0;
  color: var(--color-text-light);
  transition: transform var(--duration-fast), color var(--duration-fast);
}

.article-children__link:hover .article-children__arrow {
  color: var(--color-accent);
  transform: translateX(3px);
}

/* Two-column layout with sidebar */
.article-page__with-sidebar {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: var(--space-12);
  align-items: start;
}

.article-page__main {
  min-width: 0;
}

/* Sidebar */
.article-sidebar {
  position: sticky;
  top: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.article-sidebar__block {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
}

.article-sidebar__heading {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.article-sidebar__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.article-sidebar__link {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  line-height: var(--leading-snug);
  display: block;
  transition: color var(--duration-fast);
}

.article-sidebar__link:hover {
  color: var(--color-accent);
}

.article-sidebar__cta {
  background: var(--color-accent);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.article-sidebar__cta-title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: #fff;
  line-height: var(--leading-snug);
}

.article-sidebar__cta-desc {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.85);
  line-height: var(--leading-normal);
}

.article-sidebar__cta-btn {
  display: inline-block;
  background: #fff;
  color: var(--color-accent);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  text-decoration: none;
  margin-top: var(--space-2);
  transition: opacity var(--duration-fast);
}

.article-sidebar__cta-btn:hover {
  opacity: 0.9;
}

@media (max-width: 900px) {
  .article-page__with-sidebar {
    grid-template-columns: 1fr;
  }

  .article-sidebar {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .article-sidebar__block,
  .article-sidebar__cta {
    flex: 1 1 260px;
  }
}

/* Offer list */
.offer-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  margin-bottom: var(--space-8);
}
</style>
