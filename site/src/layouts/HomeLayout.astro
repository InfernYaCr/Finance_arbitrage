---
import BaseLayout from './BaseLayout.astro';
import type { FullPage, SeoFields, PageType } from '../data/types';
import { siteConfig } from '../data/siteConfig';
import { getImmediateChildPages } from '../data/loadPages';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { data } = page;

const stats = [
  { value: '500+', label: 'Реализованных проектов' },
  { value: '10', label: 'Лет на рынке SEO' },
  { value: '1000+', label: 'Запросов в ТОП-10' },
  { value: '98%', label: 'Клиентов продлевают договор' },
];

const howWeWork = [
  { num: '01', title: 'Технический аудит', desc: 'Выявляем ошибки, мешающие индексации и ранжированию сайта.' },
  { num: '02', title: 'Семантика и структура', desc: 'Собираем ключевые запросы и выстраиваем правильную структуру страниц.' },
  { num: '03', title: 'Контент и оптимизация', desc: 'Создаём и оптимизируем тексты, мета-теги и внутреннюю перелинковку.' },
  { num: '04', title: 'Ссылочное продвижение', desc: 'Наращиваем качественную внешнюю ссылочную массу.' },
];

// Get a few portfolio cases for the homepage showcase
const portfolioChildren = getImmediateChildPages('/portfolio/').slice(0, 6);
// Get a few FAQ items for the homepage FAQ block
const faqChildren = getImmediateChildPages('/faq/').slice(0, 5);
// Top services for the homepage services grid
const topServices = getImmediateChildPages('/seo-uslugi/').slice(0, 8);

const usp = [
  { icon: '📈', title: 'Результат в цифрах', desc: 'Прозрачная аналитика: трафик, позиции, заявки — в едином отчёте каждый месяц.' },
  { icon: '🔍', title: 'Глубокий аудит', desc: 'Находим скрытые технические и контентные проблемы, которые тормозят рост сайта.' },
  { icon: '⚡', title: 'Быстрый старт', desc: 'Первые правки и рекомендации — уже в течение 3 рабочих дней после запуска проекта.' },
  { icon: '🤝', title: 'Персональный менеджер', desc: 'Один специалист ведёт проект от старта до результата. Всегда на связи.' },
  { icon: '🛡️', title: 'Безопасные методы', desc: 'Работаем только белыми методами: никакого риска для репутации сайта.' },
  { icon: '🏆', title: '10 лет экспертизы', desc: 'Более 500 проектов в нишах e-commerce, услуг и B2B по всей России.' },
];
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <!-- Hero -->
  <section class="home-hero">
    <div class="container">
      <div class="home-hero__content">
        <div class="home-hero__badge">SEO-продвижение сайтов</div>
        <h1 class="home-hero__title">
          SEO-продвижение<br />сайтов в Яндекс<br />и Google
        </h1>
        <p class="home-hero__lead">
          Комплексный подход: технический аудит, семантика, контент, ссылки.
          Результат — рост органического трафика.
        </p>
        <div class="home-hero__actions">
          <a href="/kontakty/" class="btn btn--primary">Получить консультацию</a>
          <a href="/seo-uslugi/" class="btn btn--ghost">Наши услуги</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Статистика -->
  <section class="home-stats" aria-label="Ключевые показатели компании">
    <div class="container">
      <ul class="home-stats__list" role="list">
        {stats.map((stat) => (
          <li class="home-stats__item">
            <span class="home-stats__value">{stat.value}</span>
            <span class="home-stats__label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Навигация по разделам -->
  <section class="home-nav-grid">
    <div class="container">
      <ul class="home-nav-grid__list" role="list">
        {siteConfig.nav.slice(0, 6).map((item) => (
          <li class="home-nav-grid__item">
            <a href={item.path} class="home-nav-grid__link">
              <span class="home-nav-grid__label">{item.label}</span>
              <span class="home-nav-grid__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Услуги -->
  {topServices.length > 0 && (
    <section class="home-services" aria-labelledby="home-services-title">
      <div class="container">
        <div class="home-section-header">
          <h2 id="home-services-title" class="home-section-title">Наши услуги</h2>
          <a href="/seo-uslugi/" class="home-section-more">Все услуги →</a>
        </div>
        <ul class="home-services__grid" role="list">
          {topServices.map((s) => (
            <li>
              <a href={s.path} class="home-service-card">
                <span class="home-service-card__title">{s.h1 || s.title}</span>
                {s.description && (
                  <span class="home-service-card__desc">{s.description}</span>
                )}
                <span class="home-service-card__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Как мы работаем -->
  <section class="home-process" aria-labelledby="home-process-title">
    <div class="container">
      <h2 id="home-process-title" class="home-section-title">Как мы работаем</h2>
      <div class="home-process__grid">
        {howWeWork.map((step) => (
          <div class="home-process__step">
            <div class="home-process__num">{step.num}</div>
            <h3 class="home-process__step-title">{step.title}</h3>
            <p class="home-process__step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Почему мы / USP -->
  <section class="home-usp" aria-labelledby="home-usp-title">
    <div class="container">
      <h2 id="home-usp-title" class="home-section-title">Почему выбирают нас</h2>
      <ul class="home-usp__grid" role="list">
        {usp.map((item) => (
          <li class="home-usp__item">
            <span class="home-usp__icon" aria-hidden="true">{item.icon}</span>
            <h3 class="home-usp__title">{item.title}</h3>
            <p class="home-usp__desc">{item.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Кейсы -->
  {portfolioChildren.length > 0 && (
    <section class="home-cases" aria-labelledby="home-cases-title">
      <div class="container">
        <div class="home-section-header">
          <h2 id="home-cases-title" class="home-section-title">Кейсы наших клиентов</h2>
          <a href="/portfolio/" class="home-section-more">Все кейсы →</a>
        </div>
        <ul class="home-cases__grid" role="list">
          {portfolioChildren.map((c) => (
            <li class="home-case-card">
              <a href={c.path} class="home-case-card__link">
                <span class="home-case-card__label">Кейс</span>
                <span class="home-case-card__title">{c.h1 || c.title}</span>
                {c.description && (
                  <span class="home-case-card__desc">{c.description}</span>
                )}
                <span class="home-case-card__cta" aria-hidden="true">Читать кейс →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faqChildren.length > 0 && (
    <section class="home-faq" aria-labelledby="home-faq-title">
      <div class="container container--md">
        <div class="home-section-header">
          <h2 id="home-faq-title" class="home-section-title">Вопросы и ответы</h2>
          <a href="/faq/" class="home-section-more">Все вопросы →</a>
        </div>
        <ul class="home-faq__list" role="list">
          {faqChildren.map((faq) => (
            <li class="home-faq__item">
              <a href={faq.path} class="home-faq__link">
                <span class="home-faq__q">{faq.h1 || faq.title}</span>
                <span class="home-faq__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA-баннер -->
  <section class="home-cta">
    <div class="container">
      <div class="home-cta__inner">
        <div class="home-cta__text">
          <h2 class="home-cta__title">Готовы вырасти в поиске?</h2>
          <p class="home-cta__desc">Расскажите о проекте — оценим потенциал и предложим план продвижения бесплатно.</p>
        </div>
        <div class="home-cta__actions">
          <a href="/kontakty/" class="btn btn--primary">Обсудить проект</a>
          <a href="/stoimost-uslug/" class="btn btn--ghost">Стоимость услуг</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Shared section utils ── */
.home-section-title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  color: var(--color-text);
}

.home-section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
  flex-wrap: wrap;
}

.home-section-more {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-accent);
  text-decoration: none;
  white-space: nowrap;
}

.home-section-more:hover {
  text-decoration: underline;
}

/* ── Hero ── */
.home-hero {
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-border);
}

.home-hero__badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-accent);
  background: var(--color-accent-light);
  padding: 0.2em 0.8em;
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-5);
}

.home-hero__content {
  max-width: 36rem;
}

.home-hero__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: var(--space-6);
}

.home-hero__lead {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-8);
  max-width: 44ch;
}

.home-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

/* ── Buttons ── */
.btn {
  display: inline-block;
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}

.btn--primary {
  background: var(--color-accent);
  color: #fff;
}

.btn--primary:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

.btn--ghost {
  background: transparent;
  color: var(--color-accent);
  border: 1.5px solid var(--color-accent);
}

.btn--ghost:hover {
  background: var(--color-accent-light);
}

/* ── Stats ── */
.home-stats {
  padding: var(--space-10) 0;
  background: var(--color-accent);
}

.home-stats__list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
  list-style: none;
}

.home-stats__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-2);
}

.home-stats__value {
  font-size: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  font-weight: var(--weight-bold);
  line-height: 1;
  color: #fff;
  letter-spacing: -0.03em;
}

.home-stats__label {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.8);
  line-height: var(--leading-snug);
  max-width: 14ch;
}

/* ── Nav grid ── */
.home-nav-grid {
  padding: var(--space-10) 0;
  border-bottom: 1px solid var(--color-border);
}

.home-nav-grid__list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1px;
  background: var(--color-border);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  list-style: none;
}

.home-nav-grid__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-6);
  background: var(--color-bg);
  color: var(--color-text);
  text-decoration: none;
  font-weight: var(--weight-medium);
  transition: background var(--duration-fast);
}

.home-nav-grid__link:hover {
  background: var(--color-surface);
  color: var(--color-accent);
}

.home-nav-grid__arrow {
  color: var(--color-text-light);
  font-size: var(--text-lg);
  transition: transform var(--duration-fast) var(--ease-out);
}

.home-nav-grid__link:hover .home-nav-grid__arrow {
  transform: translateX(4px);
  color: var(--color-accent);
}

/* ── How we work ── */
.home-process {
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-border);
}

.home-process > .container > .home-section-title {
  margin-bottom: var(--space-10);
}

.home-process__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: var(--space-6);
}

.home-process__step {
  position: relative;
  padding: var(--space-6);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
}

.home-process__num {
  font-size: var(--text-3xl);
  font-weight: var(--weight-bold);
  color: var(--color-accent-light);
  line-height: 1;
  margin-bottom: var(--space-4);
  letter-spacing: -0.04em;
}

.home-process__step-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

.home-process__step-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

/* ── Cases ── */
.home-cases {
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-border);
}

.home-cases__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: var(--space-4);
  list-style: none;
}

.home-case-card__link {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-6);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  text-decoration: none;
  color: var(--color-text);
  height: 100%;
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.home-case-card__link:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-md);
  color: var(--color-text);
}

.home-case-card__label {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-accent);
}

.home-case-card__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-snug);
  color: var(--color-text);
}

.home-case-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  flex: 1;
}

.home-case-card__cta {
  font-size: var(--text-sm);
  color: var(--color-accent);
  font-weight: var(--weight-medium);
  margin-top: var(--space-2);
  transition: opacity var(--duration-fast);
}

.home-case-card__link:hover .home-case-card__cta {
  opacity: 0.7;
}

/* ── Home content ── */
.home-content {
  padding: var(--space-12) 0 var(--space-section);
  border-bottom: 1px solid var(--color-border);
}

/* ── FAQ ── */
.home-faq {
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-border);
}

.home-faq__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-border);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.home-faq__item {
  background: var(--color-bg);
}

.home-faq__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-6);
  text-decoration: none;
  color: var(--color-text);
  transition: background var(--duration-fast);
}

.home-faq__link:hover {
  background: var(--color-surface);
  color: var(--color-text);
}

.home-faq__q {
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  line-height: var(--leading-snug);
}

.home-faq__arrow {
  color: var(--color-accent);
  flex-shrink: 0;
  font-size: var(--text-sm);
  transition: transform var(--duration-fast) var(--ease-out);
}

.home-faq__link:hover .home-faq__arrow {
  transform: translateX(3px);
}

/* ── CTA ── */
.home-cta {
  padding: var(--space-section) 0;
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
}

.home-cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  flex-wrap: wrap;
}

.home-cta__title {
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-3);
}

.home-cta__desc {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  max-width: 50ch;
  line-height: var(--leading-normal);
}

.home-cta__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  flex-shrink: 0;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .home-stats__list {
    grid-template-columns: repeat(2, 1fr);
  }

  .home-cta__inner {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .home-stats__list {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
}

/* Services grid */
.home-services {
  padding: var(--space-section) 0 0;
}

.home-services__grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--space-4);
}

.home-service-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6);
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-accent);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  text-decoration: none;
  color: inherit;
  position: relative;
  transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
}

.home-service-card:hover {
  border-color: var(--color-accent);
  box-shadow: 0 2px 16px rgba(0,0,0,0.07);
}

.home-service-card__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  line-height: var(--leading-snug);
  padding-right: var(--space-5);
}

.home-service-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.home-service-card__arrow {
  position: absolute;
  top: var(--space-5);
  right: var(--space-4);
  color: var(--color-text-light);
  font-size: var(--text-base);
  transition: color var(--duration-fast), transform var(--duration-fast);
}

.home-service-card:hover .home-service-card__arrow {
  color: var(--color-accent);
  transform: translateX(3px);
}

/* USP block */
.home-usp {
  padding: var(--space-section) 0 0;
}

.home-usp__grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--space-6);
  margin-top: var(--space-8);
}

.home-usp__item {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.home-usp__icon {
  font-size: 1.75rem;
  line-height: 1;
  margin-bottom: var(--space-1);
}

.home-usp__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
