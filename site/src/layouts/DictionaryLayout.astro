---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { FullPage, SeoFields, PageType } from '../data/types';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { data } = page;
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <article class="dict-page">
    <div class="container container--md">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="dict-page__header">
        <div class="dict-page__badge">SEO-словарь</div>
        {seo.h1 && <h1 class="dict-page__title">{seo.h1}</h1>}
        {seo.description && <p class="dict-page__def">{seo.description}</p>}
      </header>

      <div class="prose dict-page__body" set:html={data.content_html} />

      <footer class="dict-page__footer">
        <a href="/seo-wikipedia/" class="dict-page__back">← Все термины</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
.dict-page {
  padding: var(--space-10) 0 var(--space-section);
}

.dict-page__header {
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-8);
  border-bottom: 1px solid var(--color-border);
}

.dict-page__badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  background: var(--color-surface-alt);
  padding: 0.25em 0.75em;
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-4);
}

.dict-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.dict-page__def {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  font-style: italic;
}

.dict-page__body {
  margin-top: var(--space-4);
}

.dict-page__footer {
  margin-top: var(--space-10);
  padding-top: var(--space-6);
  border-top: 1px solid var(--color-border);
}

.dict-page__back {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
}

.dict-page__back:hover {
  color: var(--color-accent);
}
</style>
