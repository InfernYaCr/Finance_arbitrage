---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getImmediateChildPages, getDescendantPages } from '../data/loadPages';
import { siteConfig } from '../data/siteConfig';
import type { FullPage, SeoFields, PageType } from '../data/types';

interface Props {
  page: FullPage;
  seo: SeoFields;
  jsonLd: object[];
  pageType: PageType;
}

const { page, seo, jsonLd } = Astro.props;
const { data } = page;

const directChildren = getImmediateChildPages(page.path);
const descendantPages = getDescendantPages(page.path);

const cards = directChildren.map((child) => ({
  page: child,
  sublinks: descendantPages
    .filter((d) => d.path !== child.path && d.path.startsWith(child.path))
    .slice(0, 5),
}));
---

<BaseLayout seo={seo} jsonLd={jsonLd} currentPath={page.path}>
  <section class="listing-page">
    <div class="container container--lg">
      <Breadcrumbs crumbs={seo.breadcrumbs} />

      <header class="listing-page__header">
        {seo.h1 && <h1 class="listing-page__title">{seo.h1}</h1>}
        {seo.description && <p class="listing-page__desc">{seo.description}</p>}
      </header>

      {data.content_html && cards.length === 0 && (
        <div class="prose listing-page__body" set:html={data.content_html} />
      )}

      {cards.length > 0 && (
        <div class="listing-grid" aria-label="Разделы">
          {cards.map(({ page: child, sublinks }) => (
            <article class="listing-card">
              <a class="listing-card__title" href={child.path}>
                {child.h1 || child.title}
              </a>
              {child.description && (
                <p class="listing-card__desc">{child.description}</p>
              )}
              {sublinks.length > 0 && (
                <ul class="listing-card__links" role="list">
                  {sublinks.map((sub) => (
                    <li>
                      <a href={sub.path}>{sub.h1 || sub.title}</a>
                    </li>
                  ))}
                </ul>
              )}
              <a class="listing-card__btn" href={child.path}>
                Подробнее →
              </a>
            </article>
          ))}
        </div>
      )}

      <div class="listing-page__cta">
        <div class="listing-cta">
          <p class="listing-cta__title">{siteConfig.niche.ctaQuestion}</p>
          <a href={siteConfig.contactPath} class="listing-cta__btn">
            {siteConfig.niche.ctaBtn}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.listing-page {
  padding: var(--space-10) 0 var(--space-section);
}

.listing-page__header {
  margin-bottom: var(--space-10);
  max-width: var(--container-sm);
}

.listing-page__title {
  font-size: var(--text-hero);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.listing-page__desc {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

.listing-page__body {
  margin-bottom: var(--space-10);
}

.listing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  gap: var(--space-5);
}

.listing-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-6);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.listing-card:hover {
  border-color: var(--color-accent);
  box-shadow: 0 2px 12px color-mix(in srgb, var(--color-accent) 10%, transparent);
}

.listing-card__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  text-decoration: none;
  line-height: var(--leading-snug);
}

.listing-card__title:hover {
  color: var(--color-accent);
}

.listing-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  flex: 1;
}

.listing-card__links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.listing-card__links a {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  line-height: var(--leading-normal);
}

.listing-card__links a:hover {
  color: var(--color-accent);
}

.listing-card__btn {
  display: inline-block;
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-accent);
  text-decoration: none;
  margin-top: auto;
  padding-top: var(--space-2);
}

.listing-card__btn:hover {
  opacity: 0.8;
}

/* CTA */
.listing-page__cta {
  margin-top: var(--space-12);
}

.listing-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-lg);
  padding: var(--space-6) var(--space-8);
}

.listing-cta__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
}

.listing-cta__btn {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-md);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background var(--duration-fast) var(--ease-out);
}

.listing-cta__btn:hover {
  background: var(--color-accent-hover);
  color: #fff;
}

@media (max-width: 600px) {
  .listing-cta {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
