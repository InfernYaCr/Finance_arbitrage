---
import { siteConfig } from '../data/siteConfig';

const { yandexMetricaId, gtagId } = siteConfig;
const isDev = import.meta.env.DEV;
---

{/* Analytics disabled in dev or when IDs are not set */}
{!isDev && yandexMetricaId && (
  <Fragment>
    <script define:vars={{ ymId: yandexMetricaId }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=" + ymId, "ym");
      ym(ymId, "init", {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: "dataLayer",
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true
      });
    </script>
    <script>
      // Goal tracking: outbound /go/ clicks and form submissions
      declare const ym: ((id: number, action: string, goal: string, params?: object) => void) | undefined;
      document.addEventListener('click', function(e) {
        const a = (e.target as Element | null)?.closest('a[href]');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        if (/^\/go\//.test(href) || /^https?:\/\//.test(href)) {
          const ymId = (window as unknown as Record<string, unknown>).__ymId as number | undefined;
          if (typeof ym !== 'undefined' && ymId) {
            ym(ymId, 'reachGoal', 'outbound_click', { url: href });
          }
        }
      });
      document.addEventListener('submit', function(e) {
        const form = e.target as HTMLElement | null;
        if (form && form.tagName === 'FORM') {
          const ymId = (window as unknown as Record<string, unknown>).__ymId as number | undefined;
          if (typeof ym !== 'undefined' && ymId) {
            ym(ymId, 'reachGoal', 'form_submit');
          }
        }
      });
    </script>
    <script define:vars={{ ymIdStore: yandexMetricaId }}>
      window.__ymId = ymIdStore;
    </script>
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${yandexMetricaId}`}
          style="position:absolute; left:-9999px;"
          alt=""
          width="1"
          height="1"
        />
      </div>
    </noscript>
  </Fragment>
)}

{!isDev && gtagId && (
  <Fragment>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
    <script define:vars={{ gId: gtagId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gId);
    </script>
  </Fragment>
)}
