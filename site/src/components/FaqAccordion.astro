---
import type { ExtractedData } from '../data/types';

interface Props {
  extracted?: ExtractedData;
  heading?: string;
}

const { extracted, heading = 'Частые вопросы' } = Astro.props;

const items = (extracted?.faq_pairs ?? [])
  .map((f) => ({ q: f.q || f.question || '', a: f.a || f.answer || '' }))
  .filter((f) => f.q && f.a);

if (items.length === 0) return;
---

<section class="faq-accordion" aria-labelledby="faq-accordion-heading">
  <h2 id="faq-accordion-heading" class="faq-accordion__title">{heading}</h2>
  {items.map((item) => (
    <details class="faq-item">
      <summary class="faq-item__q">
        <span>{item.q}</span>
        <span class="faq-item__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq-item__a">{item.a}</div>
    </details>
  ))}
</section>

<style>
.faq-accordion {
  margin-top: var(--space-10);
}

.faq-accordion__title {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.faq-item {
  border-bottom: 1px solid var(--color-border);
}

.faq-item:first-of-type {
  border-top: 1px solid var(--color-border);
}

.faq-item__q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4) 0;
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text);
  cursor: pointer;
  list-style: none;
  user-select: none;
}

.faq-item__q::-webkit-details-marker {
  display: none;
}

.faq-item__icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--duration-fast), transform var(--duration-fast);
  position: relative;
}

.faq-item__icon::before,
.faq-item__icon::after {
  content: '';
  position: absolute;
  background: var(--color-text-muted);
  border-radius: 1px;
  transition: transform var(--duration-fast), opacity var(--duration-fast);
}

.faq-item__icon::before {
  width: 8px;
  height: 1.5px;
}

.faq-item__icon::after {
  width: 1.5px;
  height: 8px;
}

.faq-item[open] .faq-item__icon {
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.faq-item[open] .faq-item__icon::before,
.faq-item[open] .faq-item__icon::after {
  background: #fff;
}

.faq-item[open] .faq-item__icon::after {
  opacity: 0;
  transform: rotate(90deg);
}

.faq-item__a {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  padding: 0 0 var(--space-4);
  max-width: 70ch;
}
</style>
