---
import type { RelatedPageLink } from '../data/loadPages';

interface Props {
  links: RelatedPageLink[];
  heading?: string;
}

const { links, heading = 'Похожие статьи' } = Astro.props;
if (links.length === 0) return;
---

<nav class="related-pages" aria-label={heading}>
  <h2 class="related-pages__heading">{heading}</h2>
  <ul class="related-pages__list" role="list">
    {links.map((link) => (
      <li>
        <a href={link.path} class="related-pages__link">
          <span class="related-pages__title">{link.h1 || link.title}</span>
          <span class="related-pages__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
.related-pages {
  margin-top: var(--space-10);
  padding: var(--space-6);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.related-pages__heading {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.related-pages__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.related-pages__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.related-pages__list li:last-child .related-pages__link {
  border-bottom: 0;
}

.related-pages__link:hover {
  color: var(--color-accent);
}

.related-pages__title {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-snug);
  transition: color var(--duration-fast);
}

.related-pages__link:hover .related-pages__title {
  color: var(--color-accent);
}

.related-pages__arrow {
  flex-shrink: 0;
  color: var(--color-text-light);
  font-size: var(--text-sm);
  transition: transform var(--duration-fast), color var(--duration-fast);
}

.related-pages__link:hover .related-pages__arrow {
  color: var(--color-accent);
  transform: translateX(3px);
}
</style>
