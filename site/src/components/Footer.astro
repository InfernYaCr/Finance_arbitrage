---
import { siteConfig } from '../data/siteConfig';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">{siteConfig.siteName}</a>
        <p class="site-footer__tagline">{siteConfig.siteDescription}</p>
      </div>

      <nav class="site-footer__nav" aria-label="Навигация в подвале">
        <ul role="list">
          {siteConfig.nav.map((item) => (
            <li><a href={item.path}>{item.label}</a></li>
          ))}
          <li><a href="/privacy/">Политика конфиденциальности</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {siteConfig.company.name}. Все права защищены.</p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-section);
  padding: var(--space-12) 0 var(--space-8);
}

.site-footer__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-8);
  margin-bottom: var(--space-8);
}

.site-footer__logo {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  text-decoration: none;
  display: inline-block;
  margin-bottom: var(--space-3);
}

.site-footer__tagline {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  max-width: 30ch;
}

.site-footer__nav ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
}

.site-footer__nav a {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
}

.site-footer__nav a:hover {
  color: var(--color-accent);
}

.site-footer__bottom {
  padding-top: var(--space-6);
  border-top: 1px solid var(--color-border);
  font-size: var(--text-sm);
  color: var(--color-text-light);
}

@media (max-width: 640px) {
  .site-footer__inner {
    grid-template-columns: 1fr;
  }
}
</style>
