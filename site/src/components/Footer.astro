---
import { siteConfig } from '../data/siteConfig';

const year = new Date().getFullYear();
const { company, social } = siteConfig;

const products = [
  { label: 'Кредитные карты', href: '/credit-cards/' },
  { label: 'Дебетовые карты', href: '/debit-cards/' },
  { label: 'Кредиты онлайн', href: '/online-credit/' },
  { label: 'Автокредиты', href: '/autocredit/' },
  { label: 'Ипотека', href: '/ratings/luchshaya-ipoteka/' },
  { label: 'Рефинансирование', href: '/ratings/luchshee-refinansirovanie-kredita/' },
];

const content = [
  { label: 'Рейтинги', href: '/ratings/' },
  { label: 'Вопросы и ответы', href: '/qa/' },
  { label: 'Лучшие карты 2026', href: '/ratings/besplatnye-debetovye-karty/' },
  { label: 'Карты с кэшбэком', href: '/ratings/cashback-produkty/' },
  { label: 'Карты с милями', href: '/ratings/debetovye-kartu-bonus-mili/' },
];

const service = [
  { label: 'Контакты', href: import.meta.env.PUBLIC_CONTACT_PATH ?? '/kontakty/' },
  { label: 'Политика конфиденциальности', href: '/privacy/' },
];

const trustBadges = [
  { icon: '🛡', text: 'Проверенные банки' },
  { icon: '📊', text: 'Независимый рейтинг' },
  { icon: '🔒', text: 'Безопасные данные' },
  { icon: '⚡', text: 'Быстрое одобрение' },
];
---

<footer class="site-footer">
  <!-- Trust strip -->
  <div class="site-footer__trust-strip">
    <div class="container">
      <ul class="trust-strip__list" role="list">
        {trustBadges.map((b) => (
          <li class="trust-strip__item">
            <span class="trust-strip__icon" aria-hidden="true">{b.icon}</span>
            <span class="trust-strip__text">{b.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="site-footer__main">
    <div class="container">
      <div class="site-footer__grid">

        <!-- Бренд -->
        <div class="site-footer__col site-footer__col--brand">
          <a href="/" class="site-footer__logo">{siteConfig.siteName}</a>
          <p class="site-footer__desc">{siteConfig.siteDescription}</p>
          {(social.vk || social.telegram || social.ok) && (
            <div class="site-footer__socials">
              {social.vk && (
                <a href={social.vk} class="site-footer__social" target="_blank" rel="noopener noreferrer" aria-label="ВКонтакте">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M15.07 2H8.93C3.33 2 2 3.33 2 8.93v6.14C2 20.67 3.33 22 8.93 22h6.14C20.67 22 22 20.67 22 15.07V8.93C22 3.33 20.67 2 15.07 2zm3.08 13.45h-1.6c-.6 0-.79-.48-1.87-1.57-.94-.93-1.35-.94-1.58-.94-.33 0-.42.09-.42.55v1.43c0 .39-.12.63-1.16.63-1.7 0-3.59-1.03-4.92-2.94C5.38 10.5 5 8.95 5 8.61c0-.24.09-.46.55-.46h1.6c.41 0 .57.19.73.63.8 2.32 2.14 4.35 2.69 4.35.21 0 .3-.1.3-.63V10.3c-.06-1.13-.66-1.23-.66-1.63 0-.19.16-.39.41-.39h2.52c.35 0 .47.19.47.58v3.12c0 .35.16.47.26.47.21 0 .38-.12.76-.5 1.17-1.32 2.01-3.34 2.01-3.34.11-.24.3-.46.71-.46h1.6c.48 0 .59.25.48.58-.2.93-2.15 3.68-2.15 3.68-.17.27-.23.39 0 .69.17.23.72.71 1.09 1.14.68.76 1.2 1.4 1.34 1.84.15.43-.08.65-.52.65z"/>
                  </svg>
                </a>
              )}
              {social.telegram && (
                <a href={social.telegram} class="site-footer__social" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.93 6.82l-1.68 7.94c-.12.56-.46.7-.93.43l-2.56-1.89-1.24 1.19c-.14.14-.25.25-.51.25l.18-2.6 4.72-4.27c.21-.18-.04-.28-.32-.1L7.6 14.47l-2.52-.79c-.55-.17-.56-.55.12-.81l9.84-3.79c.45-.17.85.11.69.74z"/>
                  </svg>
                </a>
              )}
              {social.ok && (
                <a href={social.ok} class="site-footer__social" target="_blank" rel="noopener noreferrer" aria-label="Одноклассники">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 5a2.5 2.5 0 110 5 2.5 2.5 0 010-5zm3.94 7.94a5.5 5.5 0 01-2.69 1.39l2.42 2.42a1 1 0 11-1.41 1.41L12 17.84l-2.26 2.32a1 1 0 11-1.41-1.41l2.42-2.42a5.5 5.5 0 01-2.69-1.39 1 1 0 111.35-1.47A3.5 3.5 0 0012 14.5a3.5 3.5 0 002.59-1.13 1 1 0 111.35 1.47z"/>
                  </svg>
                </a>
              )}
            </div>
          )}
        </div>

        <!-- ПРОДУКТЫ -->
        <div class="site-footer__col">
          <h3 class="site-footer__heading">Продукты</h3>
          <ul class="site-footer__links" role="list">
            {products.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>

        <!-- КОНТЕНТ -->
        <div class="site-footer__col">
          <h3 class="site-footer__heading">Контент</h3>
          <ul class="site-footer__links" role="list">
            {content.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>

        <!-- СЕРВИС + Контакты -->
        <div class="site-footer__col">
          <h3 class="site-footer__heading">Сервис</h3>
          <ul class="site-footer__links" role="list">
            {service.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          {company.phone && (
            <div class="site-footer__contacts">
              <a href={`tel:${company.phoneHref}`} class="site-footer__phone">{company.phone}</a>
              {company.worktime && <p class="site-footer__worktime">{company.worktime}</p>}
              {company.email && (
                <a href={`mailto:${company.email}`} class="site-footer__email">{company.email}</a>
              )}
            </div>
          )}
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom -->
  <div class="site-footer__bottom">
    <div class="container">
      <div class="site-footer__bottom-inner">
        <p>© {year} {company.legalName || siteConfig.siteName}. Все права защищены.</p>
        <p class="site-footer__disclaimer">Информация на сайте носит ознакомительный характер. Не является офертой.</p>
        <nav aria-label="Юридические ссылки" class="site-footer__legal-nav">
          <a href="/privacy/">Конфиденциальность</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-section);
}

/* Trust strip */
.site-footer__trust-strip {
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-4) 0;
}

.trust-strip__list {
  display: flex;
  align-items: center;
  gap: var(--space-8);
  list-style: none;
  overflow-x: auto;
  scrollbar-width: none;
  flex-wrap: wrap;
}

.trust-strip__item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.trust-strip__icon {
  font-size: 1.1rem;
  line-height: 1;
}

.trust-strip__text {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* Main grid */
.site-footer__main {
  padding: var(--space-12) 0 var(--space-8);
}

.site-footer__grid {
  display: grid;
  grid-template-columns: 2fr 1.2fr 1.2fr 1.4fr;
  gap: var(--space-10);
}

/* Brand column */
.site-footer__logo {
  display: inline-block;
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  text-decoration: none;
  margin-bottom: var(--space-3);
}

.site-footer__logo::after {
  content: '.';
  color: var(--color-accent);
}

.site-footer__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  max-width: 28ch;
  margin-bottom: var(--space-5);
}

.site-footer__socials {
  display: flex;
  gap: var(--space-2);
}

.site-footer__social {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  text-decoration: none;
  transition: color var(--duration-fast), border-color var(--duration-fast);
}

.site-footer__social:hover {
  color: var(--color-accent);
  border-color: var(--color-accent);
}

/* Column headings */
.site-footer__heading {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

/* Links */
.site-footer__links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-6);
}

.site-footer__links a {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  line-height: var(--leading-snug);
  transition: color var(--duration-fast);
}

.site-footer__links a:hover { color: var(--color-accent); }

/* Contacts in last col */
.site-footer__contacts {
  margin-top: var(--space-4);
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.site-footer__phone {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.site-footer__phone:hover { color: var(--color-accent); }

.site-footer__worktime {
  font-size: var(--text-xs);
  color: var(--color-text-light);
}

.site-footer__email {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.site-footer__email:hover { color: var(--color-accent); }

/* Bottom bar */
.site-footer__bottom {
  border-top: 1px solid var(--color-border);
  padding: var(--space-5) 0;
}

.site-footer__bottom-inner {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
  font-size: var(--text-sm);
  color: var(--color-text-light);
}

.site-footer__disclaimer {
  flex: 1;
  font-size: var(--text-xs);
  color: var(--color-text-light);
}

.site-footer__legal-nav {
  display: flex;
  gap: var(--space-4);
  margin-left: auto;
}

.site-footer__legal-nav a {
  font-size: var(--text-sm);
  color: var(--color-text-light);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.site-footer__legal-nav a:hover { color: var(--color-accent); }

/* Responsive */
@media (max-width: 1024px) {
  .site-footer__grid { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
}

@media (max-width: 640px) {
  .site-footer__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  .site-footer__main { padding: var(--space-8) 0 var(--space-6); }
  .site-footer__bottom-inner { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .site-footer__legal-nav { margin-left: 0; }
  .trust-strip__list { gap: var(--space-5); }
}
</style>
