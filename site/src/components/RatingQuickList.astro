---
import type { TocHeading } from './TableOfContents.astro';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;

// Match headings like "1 место. Сбербанк" or "1. Продукт"
const RANK_RE = /^(\d+)\s*(?:место\.?\s+|\.?\s+)(.*)/i;

const ranked = headings
  .map((h) => {
    const m = h.text.match(RANK_RE);
    return m ? { rank: parseInt(m[1]!), label: m[2]!.trim(), id: h.id } : null;
  })
  .filter((x): x is { rank: number; label: string; id: string } => x !== null)
  .sort((a, b) => a.rank - b.rank)
  .slice(0, 10);

if (ranked.length < 3) return;
---

<section class="rating-quick" aria-labelledby="rating-quick-title">
  <h2 id="rating-quick-title" class="rating-quick__title">Краткий рейтинг</h2>
  <ol class="rating-quick__list" role="list">
    {ranked.map(({ rank, label, id }) => (
      <li class="rating-quick__item">
        <span class={`rating-quick__badge rating-quick__badge--${rank <= 3 ? rank : 'rest'}`}>
          {rank}
        </span>
        <a href={`#${id}`} class="rating-quick__label">{label}</a>
      </li>
    ))}
  </ol>
</section>

<style>
.rating-quick {
  margin-bottom: var(--space-8);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.rating-quick__title {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  padding: var(--space-4) var(--space-5);
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  margin: 0;
}

.rating-quick__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.rating-quick__item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5);
  border-bottom: 1px solid var(--color-border);
}

.rating-quick__item:last-child {
  border-bottom: 0;
}

.rating-quick__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full, 999px);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  flex-shrink: 0;
  line-height: 1;
}

.rating-quick__badge--1 {
  background: #f59e0b;
  color: #fff;
}
.rating-quick__badge--2 {
  background: var(--color-text-muted);
  color: #fff;
}
.rating-quick__badge--3 {
  background: #b45309;
  color: #fff;
}
.rating-quick__badge--rest {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.rating-quick__label {
  font-size: var(--text-sm);
  color: var(--color-text);
  text-decoration: none;
  line-height: var(--leading-snug);
  transition: color var(--duration-fast);
}

.rating-quick__label:hover {
  color: var(--color-accent);
}
</style>
