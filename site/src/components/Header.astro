---
import { siteConfig } from '../data/siteConfig';
import { navItems } from '../data/loadNav';
import type { NavItem } from '../data/nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

function isActive(item: NavItem, path: string): boolean {
  if (item.href === '/') {
    return path === '/' || path === '';
  }
  if (path.startsWith(item.href)) return true;
  if (item.columns) {
    for (const col of item.columns) {
      for (const child of col.items) {
        if (child.href !== '/' && path.startsWith(child.href)) return true;
      }
    }
  }
  return false;
}

const columnsClass = (count: number): string => {
  if (count >= 4) return 'site-dropdown--cols-4';
  if (count === 3) return 'site-dropdown--cols-3';
  if (count === 2) return 'site-dropdown--cols-2';
  return 'site-dropdown--cols-1';
};

const { company, social } = siteConfig;
---

<header class="site-header">
  <!-- Top bar: contacts + socials -->
  <div class="site-topbar">
    <div class="container">
      <div class="site-topbar__inner">

        {company.phone && (
          <a href={`tel:${company.phoneHref}`} class="site-topbar__item site-topbar__contact">
            <span class="site-topbar__icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.79 19.79 19.79 0 01.45 1.32 2 2 0 012.44 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.29 6.29l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </span>
            <span class="site-topbar__contact-text">
              <strong>{company.phone}</strong>
              <small>{company.phoneLabel}</small>
            </span>
          </a>
        )}

        {company.phone2 && (
          <a href={`tel:${company.phone2Href}`} class="site-topbar__item site-topbar__contact">
            <span class="site-topbar__icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.79 19.79 19.79 0 01.45 1.32 2 2 0 012.44 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.29 6.29l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </span>
            <span class="site-topbar__contact-text">
              <strong>{company.phone2}</strong>
              <small>{company.phone2Label}</small>
            </span>
          </a>
        )}

        {company.email && (
          <a href={`mailto:${company.email}`} class="site-topbar__item site-topbar__contact">
            <span class="site-topbar__icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M22 7l-10 7L2 7"/>
              </svg>
            </span>
            <span class="site-topbar__contact-text">
              <strong>{company.email}</strong>
              {company.telegram && <small>{company.telegram}, Telegram</small>}
            </span>
          </a>
        )}

        <div class="site-topbar__item site-topbar__callback">
          <span class="site-topbar__icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.79 19.79 19.79 0 01.45 1.32 2 2 0 012.44 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.29 6.29l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </span>
          <span class="site-topbar__contact-text">
            <a href={import.meta.env.PUBLIC_CONTACT_PATH ?? '/kontakty/'} class="site-topbar__callback-link">перезвоните мне</a>
            <small>{company.worktime}</small>
          </span>
        </div>

        <div class="site-topbar__socials">
          {social.vk && (
            <a href={social.vk} class="site-topbar__social" aria-label="ВКонтакте" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.785 16.241s.288-.032.436-.194c.136-.148.131-.427.131-.427s-.019-1.304.587-1.496c.596-.19 1.365 1.261 2.179 1.818.615.42 1.08.326 1.08.326l2.17-.03s1.136-.07.597-.963c-.044-.073-.314-.661-1.617-1.869-1.367-1.265-1.184-1.06.462-3.246 1-1.33 1.398-2.144 1.273-2.491-.12-.331-.866-.244-.866-.244l-2.44.015s-.182-.025-.315.056c-.132.079-.217.262-.217.262s-.388 1.03-1.025 1.886c-1.035 1.4-1.449 1.471-1.619 1.385-.393-.254-.295-1.063-.295-1.631 0-1.774.269-2.515-.522-2.71-.263-.064-.455-.106-1.125-.113-.861-.009-1.59.003-2.002.205-.274.134-.486.433-.357.45.159.021.52.098.712.359.248.336.239 1.09.239 1.09s.142 2.086-.332 2.347c-.325.177-.771-.184-1.728-1.834-.491-.848-.862-1.787-.862-1.787s-.071-.174-.202-.268c-.157-.113-.378-.149-.378-.149l-2.32.015s-.348.01-.476.161c-.114.135-.009.414-.009.414s1.814 4.244 3.869 6.381c1.885 1.963 4.025 1.835 4.025 1.835h.97z"/>
              </svg>
            </a>
          )}
          {social.telegram && (
            <a href={social.telegram} class="site-topbar__social" aria-label="Telegram" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </a>
          )}
          {social.ok && (
            <a href={social.ok} class="site-topbar__social" aria-label="Одноклассники" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1a5 5 0 100 10A5 5 0 0012 1zm0 8a3 3 0 110-6 3 3 0 010 6zm5.8 4.2a9.1 9.1 0 01-3.3 1.5l3.1 3.1a1 1 0 01-1.4 1.4L12 15l-4.2 4.2a1 1 0 01-1.4-1.4l3.1-3.1a9.1 9.1 0 01-3.3-1.5 1 1 0 011.2-1.6A7.1 7.1 0 0012 13a7.1 7.1 0 004.6-1.4 1 1 0 011.2 1.6z"/>
              </svg>
            </a>
          )}
        </div>

      </div>
    </div>
  </div>

  <!-- Main row: logo + nav -->
  <div class="site-header__main">
    <div class="container">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo" aria-label={siteConfig.siteName}>
          <span class="site-header__logo-text">{siteConfig.siteName}</span>
        </a>

        <nav class="site-nav" aria-label="Основная навигация" id="site-nav">
          <ul class="site-nav__list" role="list">
            {navItems.map((item) => {
              const active = isActive(item, currentPath);
              const hasDropdown = Boolean(item.columns && item.columns.length > 0);
              return (
                <li
                  class:list={['site-nav__item', { 'site-nav__item--has-dropdown': hasDropdown }]}
                  data-nav-item
                >
                  <div class="site-nav__row">
                    <a
                      href={item.href}
                      class:list={['site-nav__link', { 'site-nav__link--active': active }]}
                      aria-haspopup={hasDropdown ? 'true' : undefined}
                      aria-expanded={hasDropdown ? 'false' : undefined}
                    >
                      {item.label}
                      {hasDropdown && (
                        <svg class="site-nav__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      )}
                    </a>
                    {hasDropdown && (
                      <button
                        type="button"
                        class="site-nav__toggle"
                        aria-label={`Раскрыть подменю «${item.label}»`}
                        aria-expanded="false"
                        data-submenu-toggle
                      >
                        <svg width="12" height="8" viewBox="0 0 10 6" aria-hidden="true">
                          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    )}
                  </div>

                  {hasDropdown && item.columns && (
                    <div
                      class:list={['site-dropdown', columnsClass(item.columns.length)]}
                      role="menu"
                    >
                      <div class="site-dropdown__inner">
                        {item.columns.map((col) => (
                          <div class="site-dropdown__col">
                            {col.title && <div class="site-dropdown__title">{col.title}</div>}
                            <ul class="site-dropdown__list" role="list">
                              {col.items.map((child) => (
                                <li>
                                  <a
                                    href={child.href}
                                    class:list={['site-dropdown__link', { 'site-dropdown__link--active': currentPath.startsWith(child.href) && child.href !== '/' }]}
                                    role="menuitem"
                                  >
                                    <span class="site-dropdown__label">
                                      {child.label}
                                      {child.badge && <span class="site-dropdown__badge">{child.badge}</span>}
                                    </span>
                                    {child.sublabel && <span class="site-dropdown__sub">{child.sublabel}</span>}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>

        <button
          class="site-header__menu-toggle"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu-toggle
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Quick-links strip -->
  <div class="site-quicklinks" aria-label="Быстрые ссылки">
    <div class="container">
      <ul class="site-quicklinks__list" role="list">
        {navItems
          .filter((item) => item.href !== '/')
          .flatMap((item) =>
            item.columns
              ? item.columns.flatMap((col) => col.items.slice(0, 2))
              : [{ label: item.label, href: item.href }]
          )
          .slice(0, 8)
          .map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['site-quicklinks__link', { 'site-quicklinks__link--active': currentPath === link.href }]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const DESKTOP_MQ = '(min-width: 901px)';

  function isDesktop(): boolean {
    return window.matchMedia(DESKTOP_MQ).matches;
  }

  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');

  burger?.addEventListener('click', () => {
    const expanded = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('site-nav--open');
  });

  const items = document.querySelectorAll<HTMLLIElement>('[data-nav-item]');

  function closeAll(except?: HTMLLIElement): void {
    items.forEach((li) => {
      if (li === except) return;
      li.classList.remove('site-nav__item--open');
      const link = li.querySelector<HTMLAnchorElement>('.site-nav__link[aria-haspopup="true"]');
      const toggle = li.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
      link?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  }

  function openItem(li: HTMLLIElement): void {
    li.classList.add('site-nav__item--open');
    const link = li.querySelector<HTMLAnchorElement>('.site-nav__link[aria-haspopup="true"]');
    const toggle = li.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    link?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  function closeItem(li: HTMLLIElement): void {
    li.classList.remove('site-nav__item--open');
    const link = li.querySelector<HTMLAnchorElement>('.site-nav__link[aria-haspopup="true"]');
    const toggle = li.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    link?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  items.forEach((li) => {
    if (!li.classList.contains('site-nav__item--has-dropdown')) return;

    li.addEventListener('mouseenter', () => {
      if (!isDesktop()) return;
      closeAll(li);
      openItem(li);
    });

    li.addEventListener('mouseleave', () => {
      if (!isDesktop()) return;
      closeItem(li);
    });

    const toggle = li.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      const open = li.classList.contains('site-nav__item--open');
      if (open) {
        closeItem(li);
      } else {
        if (isDesktop()) closeAll(li);
        openItem(li);
      }
    });

    const link = li.querySelector<HTMLAnchorElement>('.site-nav__link[aria-haspopup="true"]');
    link?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        openItem(li);
        const first = li.querySelector<HTMLAnchorElement>('.site-dropdown__link');
        first?.focus();
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      const active = document.activeElement;
      if (active instanceof HTMLElement && active.closest('[data-nav-item]')) {
        const parent = active.closest<HTMLLIElement>('[data-nav-item]');
        const trigger = parent?.querySelector<HTMLAnchorElement>('.site-nav__link');
        trigger?.focus();
      }
    }
  });

  document.addEventListener('click', (e) => {
    if (!isDesktop()) return;
    const target = e.target;
    if (target instanceof Node && !document.querySelector('.site-nav')?.contains(target)) {
      closeAll();
    }
  });
</script>

<style>
/* ── Header shell ── */
.site-header {
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 100;
}

/* ── Top bar ── */
.site-topbar {
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
}

.site-topbar__inner {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  height: 2.75rem;
  flex-wrap: nowrap;
}

.site-topbar__item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
  text-decoration: none;
  color: var(--color-text);
}

.site-topbar__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  border: 1.5px solid var(--color-border);
  color: var(--color-text-light);
  flex-shrink: 0;
}

.site-topbar__contact:hover .site-topbar__icon {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.site-topbar__contact-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.site-topbar__contact-text strong {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  white-space: nowrap;
}

.site-topbar__contact:hover .site-topbar__contact-text strong {
  color: var(--color-accent);
}

.site-topbar__contact-text small {
  font-size: 0.68rem;
  color: var(--color-text-light);
  white-space: nowrap;
}

.site-topbar__callback {
  margin-left: auto;
}

.site-topbar__callback-link {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-accent);
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

.site-topbar__callback-link:hover {
  text-decoration: none;
}

/* Socials */
.site-topbar__socials {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding-left: var(--space-3);
  border-left: 1px solid var(--color-border);
}

.site-topbar__social {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-sm);
  color: var(--color-text-light);
  transition: background var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out);
}

.site-topbar__social:hover {
  background: var(--color-accent-light);
  color: var(--color-accent);
}

/* ── Main row: logo + nav ── */
.site-header__main {
  position: relative;
}

.site-header__inner {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  height: 4rem;
}

.site-header__logo {
  text-decoration: none;
  flex-shrink: 0;
}

.site-header__logo-text {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.site-header__logo-text::after {
  content: '.';
  color: var(--color-accent);
}

.site-nav {
  margin-left: auto;
}

.site-nav__list {
  display: flex;
  align-items: stretch;
  gap: 0;
  list-style: none;
}

.site-nav__item {
  position: relative;
  display: flex;
  align-items: stretch;
}

.site-nav__row {
  display: flex;
  align-items: center;
}

.site-nav__link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  height: 4rem;
  padding: 0 var(--space-3);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text);
  text-decoration: none;
  border-bottom: 2px solid transparent;
  transition: color var(--duration-fast) var(--ease-out),
              border-color var(--duration-fast) var(--ease-out);
}

.site-nav__link:hover {
  color: var(--color-accent);
}

.site-nav__link--active {
  color: var(--color-accent);
  border-bottom-color: var(--color-accent);
}

.site-nav__caret {
  transition: transform var(--duration-fast) var(--ease-out);
  color: var(--color-text-light);
}

.site-nav__item--open .site-nav__caret,
.site-nav__item:hover .site-nav__caret {
  transform: rotate(180deg);
  color: var(--color-accent);
}

.site-nav__toggle {
  display: none;
  background: none;
  border: 0;
  cursor: pointer;
  padding: var(--space-2);
  color: var(--color-text-muted);
}

/* ── Dropdown ── */
.site-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 18rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-top: 2px solid var(--color-accent);
  box-shadow: var(--shadow-lg);
  border-radius: 0 0 var(--radius-md) var(--radius-md);
  padding: var(--space-5) var(--space-6);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-4px);
  transition: opacity var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out),
              visibility 0s linear var(--duration-fast);
  z-index: 110;
}

.site-nav__item--open > .site-dropdown,
.site-nav__item--has-dropdown:hover > .site-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  transition-delay: 0s;
}

.site-nav__item:nth-last-child(-n+2) > .site-dropdown {
  left: auto;
  right: 0;
}

.site-dropdown__inner {
  display: grid;
  gap: var(--space-6);
}

.site-dropdown--cols-1 { min-width: 18rem; }
.site-dropdown--cols-1 .site-dropdown__inner { grid-template-columns: 1fr; gap: var(--space-2); }
.site-dropdown--cols-2 { min-width: 36rem; }
.site-dropdown--cols-2 .site-dropdown__inner { grid-template-columns: 1fr 1fr; }
.site-dropdown--cols-3 { min-width: 48rem; }
.site-dropdown--cols-3 .site-dropdown__inner { grid-template-columns: repeat(3, 1fr); }
.site-dropdown--cols-4 { min-width: 56rem; }
.site-dropdown--cols-4 .site-dropdown__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }

.site-dropdown__title {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-text-light);
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-border);
}

.site-dropdown__list {
  list-style: none;
  display: grid;
  gap: var(--space-1);
}

.site-dropdown__link {
  display: block;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  text-decoration: none;
  color: var(--color-text);
  transition: background var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out);
}

.site-dropdown__link:hover,
.site-dropdown__link:focus-visible {
  background: var(--color-accent-light);
  color: var(--color-accent);
  outline: none;
}

.site-dropdown__link--active {
  color: var(--color-accent);
}

.site-dropdown__label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
