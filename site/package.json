{
  "name": "seo-site",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' astro build && node scripts/generate-sitemap.mjs && node scripts/generate-mail-php.mjs",
    "build:astro": "NODE_OPTIONS='--max-old-space-size=8192' astro build",
    "preview": "astro preview",
    "check:b0": "node scripts/check-b0-env.mjs",
    "check": "astro check",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "deploy:file": "bash scripts/deploy-file.sh"
  },
  "dependencies": {
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
