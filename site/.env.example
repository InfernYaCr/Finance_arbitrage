# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env: там будут ключи, FTP-пароль и контакты сайта.

# [обязательно] Домен продакшен-сайта. Используется в canonical URL, sitemap.xml и редиректе формы по умолчанию.
# Формат: полный URL с https://, без слэша на конце. Пример: https://example.com
SITE_URL=https://example.test

# [опционально] Output директория контента для сборки Astro.
# По умолчанию используется ../site_pipeline/output. Для теста донора: ../site_pipeline/output/finance_test
CONTENT_OUTPUT_DIR=../site_pipeline/output

# [опционально] Локальные editorialPosts добавляются только для основного Mosseo-derived сайта.
# Для донорских тестов оставьте false.
ENABLE_EDITORIAL_POSTS=true

# B0 predeploy checklist: каждый продакшен-сайт обязан иметь уникальные значения ниже.

# [обязательно] Короткое публичное название бренда в шапке, футере, SEO и JSON-LD.
# Формат: текст, 2-5 слов. Не используйте тестовые или донорские названия.
PUBLIC_SITE_NAME=

# [обязательно] Полное название бренда для title главной страницы и расширенных SEO-заголовков.
# Формат: текст с брендом и описанием услуги. Пример: Example SEO — продвижение сайтов
PUBLIC_SITE_NAME_FULL=

# [обязательно] Уникальный числовой ID счетчика Яндекс Метрики для этого сайта.
# Формат: только цифры, минимум 5 символов. Пример: 12345678
PUBLIC_METRIKA_ID=

# [обязательно] Основной телефон в человекочитаемом виде, например: +7 901 123-45-67.
# Формат: текст для показа пользователю. Пример: +7 901 123-45-67
PUBLIC_COMPANY_PHONE=

# [обязательно] Основной телефон для tel-ссылки без пробелов и скобок, например: +79011234567.
# Формат: + и цифры, без пробелов, скобок и дефисов. Пример: +79011234567
PUBLIC_COMPANY_PHONE_HREF=

# [опционально] Подпись под основным телефоном в верхней панели и контактах.
# Формат: короткий текст. Пример: звонок по РФ бесплатный
PUBLIC_COMPANY_PHONE_LABEL=звонок по РФ бесплатный

# [опционально] Второй телефон. Оставьте пустым, если не нужен.
# Формат: текст для показа пользователю. Пример: +7 495 123-45-67
PUBLIC_COMPANY_PHONE2=

# [опционально] Второй телефон для tel-ссылки. Заполняйте только вместе с PUBLIC_COMPANY_PHONE2.
# Формат: + и цифры, без пробелов, скобок и дефисов. Пример: +74951234567
PUBLIC_COMPANY_PHONE2_HREF=

# [опционально] Подпись под вторым телефоном.
# Формат: короткий текст. Пример: офис в Москве
PUBLIC_COMPANY_PHONE2_LABEL=

# [обязательно] Публичная почта для заявок и mailto-ссылок.
# Формат: email. Пример: hello@example.com
PUBLIC_COMPANY_EMAIL=

# [обязательно] Публичный адрес компании или офиса для страницы контактов.
# Формат: текстовый адрес. Пример: Москва, Тверская улица, 1
PUBLIC_COMPANY_ADDRESS=

# [опционально] График работы. Если пусто, будет использовано значение из siteConfig.
# Формат: короткий текст. Пример: Пн-Пт, 10:00-19:00
PUBLIC_COMPANY_WORKTIME=Пн-Пт, 09:30-18:30

# [опционально] Username Telegram без https://t.me/. Оставьте пустым, чтобы скрыть.
# Формат: username без @ и без URL. Пример: example_support
PUBLIC_COMPANY_TELEGRAM=

# [опционально] Юридическое название компании для реквизитов.
# Формат: полное юрлицо. Пример: ООО «Example»
PUBLIC_COMPANY_LEGAL_NAME=

# [опционально] ИНН компании для страницы реквизитов.
# Формат: 10 или 12 цифр.
PUBLIC_COMPANY_INN=

# [опционально] КПП компании для страницы реквизитов.
# Формат: 9 цифр.
PUBLIC_COMPANY_KPP=

# [опционально] ОГРН компании для страницы реквизитов.
# Формат: 13 или 15 цифр.
PUBLIC_COMPANY_OGRN=

# [опционально] Название банка для страницы реквизитов.
# Формат: текст. Пример: АО «Банк»
PUBLIC_COMPANY_BANK=

# [опционально] БИК банка для страницы реквизитов.
# Формат: 9 цифр.
PUBLIC_COMPANY_BIK=

# [опционально] Расчетный счет компании для страницы реквизитов.
# Формат: 20 цифр.
PUBLIC_COMPANY_ACCOUNT=

# [опционально] Корреспондентский счет банка для страницы реквизитов.
# Формат: 20 цифр.
PUBLIC_COMPANY_CORRESPONDENT_ACCOUNT=

# Контактная форма для статического хостинга.
# Основной вариант для Beget: PHP-скрипт /mail.php генерируется в dist во время npm run build.
# Formspree можно использовать как запасной вариант на хостингах без PHP.

# [обязательно] Endpoint формы. Для Beget используйте /mail.php.
# Формат: /mail.php или fallback https://formspree.io/f/xxxxxxx
PUBLIC_CONTACT_FORM_ACTION=/mail.php

# [опционально] Email-получатель заявок из mail.php. Если пусто, используется PUBLIC_COMPANY_EMAIL.
# Формат: email. Пример: leads@example.com
PUBLIC_CONTACT_FORM_TO=

# [опционально] URL страницы после успешной отправки. Если пусто, используется SITE_URL + /thanks/.
# Формат: полный URL с https:// или root-relative path. Примеры: https://example.com/thanks/ или /thanks/
PUBLIC_CONTACT_FORM_REDIRECT=

# [опционально] Тема письма/заявки.
# Формат: короткий текст. Пример: Новая заявка с сайта Example SEO
PUBLIC_CONTACT_FORM_SUBJECT=

# [опционально] Старый домен-донор для legacy media/links.
# Формат: полный URL без слэша на конце. Пример: https://vsezaimyonline.ru
PUBLIC_LEGACY_SOURCE_DOMAIN=

# [опционально] Алиасы бренда донора, которые нужно заменить на PUBLIC_SITE_NAME при рендере.
# Формат: значения через запятую. Пример: ВсеЗаймыОнлайн,Все Займы Онлайн,VseZaimyOnline
PUBLIC_LEGACY_BRAND_ALIASES=

# [опционально] Режим старых медиа: placeholder | source | local.
# placeholder скрывает донорские картинки, source грузит с донора, local ждёт файлы в public/.
PUBLIC_LEGACY_MEDIA_MODE=placeholder

# [опционально] Заглушка для старых медиа.
PUBLIC_MEDIA_PLACEHOLDER=/images/placeholder.svg

# [опционально] ID Google Analytics / gtag. Оставьте пустым, чтобы отключить.
# Формат: G-XXXXXXXXXX или другой ID, который выдает Google Analytics.
GTAG_ID=

# Настройки Beget FTP deploy.

# [обязательно для deploy] FTP-логин Beget.
# Формат: логин аккаунта/FTP-пользователя Beget. Пример: examplelogin
BEGET_FTP_USER=yourlogin

# [обязательно для deploy] FTP-пароль Beget. Не коммитьте реальное значение.
# Формат: строка пароля без кавычек, если в пароле нет специальных shell-символов.
BEGET_FTP_PASS=

# [обязательно для deploy] Хост сайта на Beget.
# Формат: домен или технический домен Beget без протокола. Пример: examplelogin.beget.tech
BEGET_HOST=yourlogin.beget.tech

# [обязательно для deploy] Путь на FTP, куда загружать содержимое dist.
# Формат: абсолютный FTP-путь, начинается со слэша. Для корня сайта обычно: /
BEGET_FTP_PATH=/
